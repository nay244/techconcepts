{
  "name": "techconcepts",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/check-budgets.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:visual": "playwright test --grep @visual",
    "deploy": "wrangler deploy",
    "budgets": "node scripts/check-budgets.mjs",
    "fact-check": "node scripts/fact-check.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "astro": "^7.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "4.157.0"
  }
}
