---
// The brand rules (.brand) come with SiteHeader, which always renders alongside this.
// The role is said outright: a split page (the track page) renders this footer at the end of its scrolling route,
// inside main, where a plain <footer> would stop being the page's contentinfo landmark.
---

<footer class="site-foot" role="contentinfo">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/" aria-label="TechConcepts home">
          <svg width="30" height="26" viewBox="0 0 34 30" aria-hidden="true">
            <polygon points="17,3 31,11 17,19 3,11" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round"></polygon>
            <polyline points="3,11 3,15 17,23 31,15 31,11" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round"></polyline>
            <circle cx="11" cy="11" r="2.6" fill="var(--here)"></circle><circle cx="23" cy="11" r="2.6" fill="var(--accent)"></circle>
          </svg>
          <b>TechConcepts</b>
        </a>
        <p>Guided visual lessons on how technology works.</p>
      </div>
      <div>
        <h3>Learn</h3>
        <ul>
          <li><a href="/how-the-internet-works">How the Internet Works</a></li>
          <li><a href="/networking">Networking Concepts</a></li>
          <li><a href="/tracks">All tracks</a></li>
          <li><a href="/#how">How a lesson works</a></li>
        </ul>
      </div>
      <div>
        <h3>Site</h3>
        <ul>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-base">Your progress is saved only in this browser.</div>
  </div>
</footer>

<style is:global>
  .site-foot {
    margin-top: 128px;
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    gap: 32px;
    padding: 56px 0 40px;
  }
  .foot-grid p {
    margin: 14px 0 0;
    max-width: 24em;
    color: var(--muted);
    font-size: 15.5px;
  }
  .foot-grid h3 {
    margin: 4px 0 14px;
    font: 700 14px/1.2 var(--sans);
    color: var(--ink-strong);
  }
  .foot-grid ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15.5px;
  }
  .foot-grid ul a {
    color: var(--muted);
    text-decoration: none;
  }
  .foot-grid ul a:hover {
    color: var(--ink-strong);
  }
  .foot-base {
    border-top: 1px solid var(--line);
    padding: 20px 0 28px;
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .site-foot {
      margin-top: 96px;
    }
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot-grid > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
