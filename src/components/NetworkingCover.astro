---
// The Networking track's cover on its page (track-v2): the router on its plate, with the figure's number and name in
// the top corners. src/scripts/router-cover.ts makes it a button that sends packets along the cable, and shows the
// hint and the count in the bottom corners; without JavaScript it is only a figure, so those two stay hidden.
import { cover, coverDescription, routerDrawing } from '../art/figures/covers';
import './page-hero.css';

interface Props {
  /** The top-left corner: which track this is, "Track 1". */
  label: string;
}

const { label } = Astro.props;
// The packets' path along the cable, worked out with the drawing; the script only reads it.
const path = JSON.stringify(routerDrawing().path);
---

<figure class="cover" data-router-cover={path}>
  <div class="plate">
    <span class="corner c-fig">{label}</span><span class="corner c-title">Networking</span>
    {/* The stage's own name says this, so the hint is for the eye only. */}
    <span class="corner c-hint" data-hint aria-hidden="true" hidden>Click to send packets</span>
    <span class="corner c-read" data-readout aria-live="polite" hidden>0 packets received</span>
    <div class="stage" data-stage set:html={cover('networking')} />
    {/* Once the stage is a button its figure's label is not read out, so the script points the button here. */}
    <p id="router-cover-description" data-description hidden>{coverDescription('networking')}</p>
  </div>
</figure>

<script>
  import { startRouterCover } from '../scripts/router-cover';

  const root = document.querySelector<HTMLElement>('[data-router-cover]');
  if (root) startRouterCover(root);
</script>

<style is:global>
  /* The plate and its corners are page-hero.css's; these are the parts only this live cover has. */
  .cover .c-read {
    right: 18px;
    bottom: 16px;
    color: var(--corner-strong);
    font-variant-numeric: tabular-nums;
  }
  .cover .stage[role='button'] {
    cursor: pointer;
  }
  .cover .stage:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
