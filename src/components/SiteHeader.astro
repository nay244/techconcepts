---
import { logoMark } from '../art/logo';
import './ThemeToggle.css';
import './site.css';

interface Props {
  /** The section the page belongs to; its link gets aria-current ("page" on the section's own page, else "true"). */
  current?: 'tracks' | 'glossary' | 'how' | 'about';
}

const { current } = Astro.props;
// Start learning opens the Tracks page, so it is not offered on Tracks or any track page (both pass current="tracks").
const showStart = current !== 'tracks';
const links = [
  { key: 'tracks', href: '/tracks', label: 'Tracks' },
  { key: 'glossary', href: '/glossary', label: 'Glossary' },
  { key: 'how', href: '/#try', label: 'How a lesson works' },
  { key: 'sources', href: '/#sources', label: 'Sources' },
  { key: 'about', href: '/about', label: 'About' },
] as const;
// The current section's link is "page" when it is this very page (/tracks), and "true" when this page sits inside its
// section (a track page under Tracks), so a screen reader does not call a link to another page "current page".
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentOf = (l: (typeof links)[number]) => (current !== l.key ? undefined : l.href === here ? 'page' : 'true');
---

<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/" aria-label="TechConcepts home">
      <Fragment set:html={logoMark()} />
      <b>TechConcepts</b>
    </a>
    <nav class="pillnav site-nav" aria-label="Site">
      {links.map((l) => <a href={l.href} aria-current={currentOf(l)}>{l.label}</a>)}
    </nav>
    <div class="head-end">
      <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Switch theme">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
        </svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
      {showStart && <a class="btn btn--primary btn--small" href="/tracks">Start learning</a>}
      <button type="button" class="icon-btn menu-btn" id="menu" aria-expanded="false" aria-controls="menu-panel" aria-label="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"></path></svg>
      </button>
    </div>
  </div>
  <nav class="menu-panel" id="menu-panel" aria-label="Site menu" hidden>
    {links.map((l) => <a href={l.href} aria-current={currentOf(l)}>{l.label}</a>)}
    {showStart && <a class="btn btn--primary" href="/tracks">Start learning</a>}
  </nav>
</header>

<script>
  import { wireThemeToggle } from '../scripts/theme-toggle';

  // The narrow-screen menu. Without JavaScript the button does nothing and the panel stays hidden.
  const button = document.getElementById('menu');
  const panel = document.getElementById('menu-panel');
  if (button && panel) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    panel.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
    // Below 960px the open menu lies over the page, so it closes when focus moves outside the header: Tab past its last
    // link, Shift+Tab past the brand to the skip link, or a tap on a control in the page. Focus stays where it went (D25).
    document.addEventListener('focusin', (e) => {
      if (button.getAttribute('aria-expanded') !== 'true') return;
      if (e.target instanceof Element && e.target.closest('.site-head')) return;
      setOpen(false);
    });
  }

  // The theme button. Without JavaScript it cannot work, so BaseLayout's <noscript> style hides it.
  const themeButton = document.getElementById('theme-toggle');
  if (themeButton) wireThemeToggle(themeButton);
</script>

<style is:global>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .site-head .wrap {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 68px;
    gap: 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    /* The lockup (docs/direction.md §8): the mark is 1.3 times the name's size, 0.36 of it away. */
    gap: 0.36em;
    justify-self: start;
    color: var(--ink-strong);
    font: 700 22px/1 var(--display);
    letter-spacing: 0.005em;
    text-decoration: none;
  }
  .brand b {
    font: inherit;
  }
  .brand .logo {
    flex: none;
    width: 1.3em;
    height: 1.3em;
  }
  .pillnav {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: var(--r-btn);
    background: color-mix(in srgb, var(--card) 70%, transparent);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .pillnav a {
    padding: 8px 14px;
    border-radius: 2px;
    color: var(--ink);
    font: 600 16px/1 var(--display);
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .pillnav a:not([aria-current]):hover {
    color: var(--ink-strong);
  }
  .pillnav a[aria-current] {
    /* The section you are in: on the page ground, with the orange under it. */
    background: var(--bg-soft);
    box-shadow: inset 0 -2px 0 var(--here);
    color: var(--ink-strong);
  }
  .head-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .menu-btn,
  .menu-panel {
    display: none;
  }

  @media (max-width: 959px) {
    .site-head .wrap {
      grid-template-columns: 1fr auto;
    }
    .site-nav,
    .head-end .btn {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .menu-panel {
      border-top: 1px solid var(--line);
      padding: 8px 16px 16px;
    }
    .menu-panel:not([hidden]) {
      display: grid;
      gap: 2px;
    }
    .menu-panel a {
      padding: 12px 4px;
      border-bottom: 1px solid var(--line);
      color: var(--ink-strong);
      font: 600 17px/1.2 var(--sans);
      text-decoration: none;
    }
    .menu-panel .btn {
      margin-top: 12px;
      border-bottom: 0;
      color: var(--accent-ink);
    }
  }
</style>
