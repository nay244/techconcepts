---
import ThemeToggle from './ThemeToggle';
import './ThemeToggle.css';
import './site.css';

interface Props {
  /** The section the page belongs to; its link gets aria-current="page". */
  current?: 'tracks' | 'how' | 'about';
  /** Home: the header sits over the hero, clear at the top of the page and solid once it scrolls (home-v6). */
  overHero?: boolean;
}

const { current, overHero = false } = Astro.props;
const links = [
  { key: 'tracks', href: '/networking', label: 'Tracks' },
  { key: 'how', href: '/#how', label: 'How it works' },
  { key: 'about', href: '/about', label: 'About' },
] as const;
---

<header class="site-head" data-over-hero={overHero ? '' : undefined}>
  <div class="wrap">
    <a class="brand" href="/" aria-label="TechConcepts home">
      <svg width="34" height="30" viewBox="0 0 34 30" aria-hidden="true">
        <polygon points="17,3 31,11 17,19 3,11" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round"></polygon>
        <polyline points="3,11 3,15 17,23 31,15 31,11" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round"></polyline>
        <line x1="11" y1="11" x2="23" y2="11" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="2 2"></line>
        <circle cx="11" cy="11" r="2.6" fill="var(--here)"></circle><circle cx="23" cy="11" r="2.6" fill="var(--accent)"></circle>
      </svg>
      <b>TechConcepts</b>
    </a>
    <nav class="site-nav" aria-label="Site">
      {links.map((l) => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="head-end">
      <ThemeToggle client:load />
      <a class="btn btn--primary btn--small" href="/networking/how-the-internet-works">Start learning</a>
      <button type="button" class="icon-btn menu-btn" id="menu" aria-expanded="false" aria-controls="menu-panel" aria-label="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"></path></svg>
      </button>
    </div>
  </div>
  <nav class="menu-panel" id="menu-panel" aria-label="Site menu" hidden>
    {links.map((l) => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
    <a class="btn btn--primary" href="/networking/how-the-internet-works">Start learning</a>
  </nav>
</header>

<script>
  // The narrow-screen menu. Without JavaScript the button does nothing and the panel stays hidden.
  const button = document.getElementById('menu');
  const panel = document.getElementById('menu-panel');
  if (button && panel) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    panel.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
  }

  // Home's header turns solid once the page has scrolled a little. Without JavaScript it is solid throughout.
  const head = document.querySelector<HTMLElement>('.site-head[data-over-hero]');
  if (head) {
    const onScroll = () => head.classList.toggle('solid', window.scrollY > 24);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style is:global>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .site-head .wrap {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    color: var(--ink-strong);
    text-decoration: none;
  }
  .brand b {
    font: 700 18px/1 var(--sans);
    letter-spacing: -0.01em;
  }
  .site-nav {
    display: flex;
    gap: 30px;
    font: 500 15.5px/1 var(--sans);
  }
  .site-nav a {
    padding: 8px 0;
    color: var(--ink);
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current] {
    color: var(--ink-strong);
  }
  .site-nav a[aria-current] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .head-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .menu-btn,
  .menu-panel {
    display: none;
  }
  .site-head[data-over-hero] {
    position: fixed;
    inset: 0 0 auto;
    border-bottom-color: transparent;
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }
  .site-head[data-over-hero].solid,
  .site-head[data-over-hero]:has(.menu-panel:not([hidden])) {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .site-head[data-over-hero] .icon-btn {
    background: color-mix(in srgb, var(--card) 70%, transparent);
  }
  .site-head[data-over-hero] .icon-btn:hover {
    background: var(--bg-soft);
  }

  @media (max-width: 720px) {
    .site-head .wrap {
      grid-template-columns: 1fr auto;
    }
    .site-nav,
    .head-end .btn {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .menu-panel {
      border-top: 1px solid var(--line);
      padding: 8px 16px 16px;
    }
    .menu-panel:not([hidden]) {
      display: grid;
      gap: 2px;
    }
    .menu-panel a {
      padding: 12px 4px;
      border-bottom: 1px solid var(--line);
      color: var(--ink-strong);
      font: 600 17px/1.2 var(--sans);
      text-decoration: none;
    }
    .menu-panel .btn {
      margin-top: 12px;
      border-bottom: 0;
      color: var(--accent-ink);
    }
  }
</style>
