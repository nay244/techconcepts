---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { analyticsBeacon, analyticsToken } from '../lib/analytics';
import { themeBootScript } from '../lib/theme';
import { tokensToCss } from '../styles/tokens';

interface Props {
  title: string;
  description: string;
  image?: string;
  /**
   * The site header and footer around the page. The lesson page turns them off:
   * its console has its own top bar and owns the whole screen, and marks its own
   * main region with id="main" for the skip link.
   */
  chrome?: boolean;
}

const SITE_NAME = 'TechConcepts';
const { title, description, image = '/og-default.png', chrome = true } = Astro.props;

// Home passes the bare site name; every other page is "<page> · TechConcepts".
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
// Social crawlers need an absolute image URL.
const beacon = analyticsBeacon(analyticsToken);
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
// The page's own absolute address on the live site.
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before anything paints: the theme boot script, then the tokens it selects between. */}
    <script is:inline set:html={themeBootScript} />
    <style is:inline set:html={tokensToCss()} />
    <noscript><style>.theme-toggle { display: none; }</style></noscript>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      chrome ? (
        <>
          <SiteHeader />
          <main id="main">
            <slot />
          </main>
          <SiteFooter />
        </>
      ) : (
        <slot />
      )
    }
    {beacon && <script is:inline {...beacon}></script>}
  </body>
</html>
