---
import '../styles/global.css';
import '../art/lumen.css';
import LumenDefs from '../components/LumenDefs.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { analyticsBeacon, analyticsToken } from '../lib/analytics';
import { themeBootScript } from '../lib/theme';
import { canonicalUrl } from '../lib/url';
import { tokensToCss } from '../styles/tokens';

interface Props {
  title: string;
  description: string;
  image?: string;
  /**
   * The site header and footer around the page. The lesson page turns them off:
   * its console has its own top bar and owns the whole screen, and marks its own
   * main region with id="main" for the skip link.
   */
  chrome?: boolean;
  /** Which header link is the current section (marked aria-current="page"). */
  current?: 'tracks' | 'how' | 'about';
  /** Home: the header sits over the hero until the page scrolls. */
  overHero?: boolean;
}

const SITE_NAME = 'TechConcepts';
const { title, description, image = '/og-default.png', chrome = true, current, overHero = false } = Astro.props;

// Home passes the bare site name; every other page is "<page> · TechConcepts".
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
// Social crawlers need an absolute image URL.
const beacon = analyticsBeacon(analyticsToken);
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
// The page's own absolute address on the live site, in the slash-less form it is served at.
const pageUrl = canonicalUrl(Astro.url.pathname, Astro.site ?? Astro.url);
// The one inline head script: the theme, then a `js` class on the root, so CSS can start hidden the parts a script
// will bring in (Home's hero) from the first paint, and show them in full when there is no JavaScript.
const bootScript = `${themeBootScript}\ndocument.documentElement.classList.add("js");`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before anything paints: the theme boot script, then the tokens it selects between. */}
    <script is:inline set:html={bootScript} />
    <style is:inline set:html={tokensToCss()} />
    {
      /* Without JavaScript nothing can switch the theme or play a lesson, so those controls are hidden: the header's
         theme toggle, and in the lesson console its Light/Dark switch, the view switch, the playback controls, the
         outline below its heading (its places are buttons), and the log's "Press Play" words, where LogPanel's own
         no-script note says the lesson needs JavaScript. The page's stylesheets load after this one and set these
         controls' display at the same specificity, so the rule is !important. */
    }
    <noscript><style>.theme-toggle, .topbar__seg, .stage__views, .console__controls, .console__outline > :not(.outline__head), .log__idle-words { display: none !important; } :root .site-head[data-over-hero] { border-bottom-color: var(--line); background: var(--bg); }</style></noscript>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <LumenDefs />
    <a class="skip-link" href="#main">Skip to content</a>
    {
      chrome ? (
        <>
          <SiteHeader current={current} overHero={overHero} />
          <main id="main">
            <slot />
          </main>
          <SiteFooter />
        </>
      ) : (
        <slot />
      )
    }
    {beacon && <script is:inline {...beacon}></script>}
  </body>
</html>
