---
import '../styles/global.css';
import '../art/lumen.css';
import LumenDefs from '../components/LumenDefs.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { analyticsBeacon, analyticsToken } from '../lib/analytics';
import { themeBootScript } from '../lib/theme';
import { canonicalUrl } from '../lib/url';
import { tokensToCss } from '../styles/tokens';

interface Props {
  title: string;
  description: string;
  image?: string;
  /**
   * The site header and footer around the page. The lesson page turns them off:
   * its console has its own top bar and owns the whole screen, and marks its own
   * main region with id="main" for the skip link.
   */
  chrome?: boolean;
  /** Which header link is the current section (marked aria-current="page"). */
  current?: 'tracks' | 'how' | 'about';
  /** Home: the header sits over the hero until the page scrolls. */
  overHero?: boolean;
  /**
   * The path of the one address search engines should index for this page, when it is served at more than one: a lesson
   * several tracks list is at a URL in each, and names the first listing track's. Left out, the page's own path.
   * `null` means no canonical link at all (the 404 page, which is no address to name); og:url stays the page's own.
   */
  canonical?: string | null;
  /**
   * Whether the layout renders the site footer after the page (default true). A split page turns it off and renders
   * <SiteFooter /> itself, at the end of the part that scrolls.
   */
  footer?: boolean;
  /**
   * A split page: a fixed card beside a route that scrolls on its own. Adds class="split" to the body, which on a large
   * screen locks the window to one screen so only the route scrolls. Below that it is an ordinary page.
   */
  split?: boolean;
}

const SITE_NAME = 'TechConcepts';
const { title, description, image = '/og-default.png', chrome = true, current, overHero = false, canonical, footer = true, split = false } = Astro.props;

// Home passes the bare site name; every other page is "<page> · TechConcepts".
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
// Social crawlers need an absolute image URL.
const beacon = analyticsBeacon(analyticsToken);
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
// The page's canonical absolute address on the live site (its own path unless it names another), in the slash-less
// form it is served at. The canonical link and og:url say the same address.
const pageUrl = canonicalUrl(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url);
// The one inline head script: the theme, then a `js` class on the root, so CSS can start hidden the parts a script
// will bring in (Home's hero) from the first paint, and show them in full when there is no JavaScript.
const bootScript = `${themeBootScript}\ndocument.documentElement.classList.add("js");`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before anything paints: the theme boot script, then the tokens it selects between. */}
    <script is:inline set:html={bootScript} />
    <style is:inline set:html={tokensToCss()} />
    {
      /* Without JavaScript nothing can switch the theme or play a lesson, so those controls are hidden: the
         header's theme toggle (the console's too); and in the lesson console the view switch, the playback
         controls, and the log's "Press Play" words, where LogPanel's own no-script note says the lesson needs
         JavaScript. The page's stylesheets load after this one and set these controls' display at the same
         specificity, so the rules are !important.
         The lesson's outline is all buttons, so it goes whole, heading and landmark too. It is made invisible rather
         than removed, so it keeps its cell and the console's grid does not move; nothing inside it sets visibility
         back. */
    }
    <noscript><style>.theme-toggle, .stage__views, .console__controls, .log__idle-words { display: none !important; } .console__outline { visibility: hidden !important; } :root .site-head[data-over-hero] { background: var(--ground); }</style></noscript>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    {canonical !== null && <link rel="canonical" href={pageUrl} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class:list={{ split }}>
    <LumenDefs />
    <a class="skip-link" href="#main">Skip to content</a>
    {
      chrome ? (
        <>
          <SiteHeader current={current} overHero={overHero} />
          <main id="main">
            <slot />
          </main>
          {footer && <SiteFooter />}
        </>
      ) : (
        <slot />
      )
    }
    {beacon && <script is:inline {...beacon}></script>}
  </body>
</html>
