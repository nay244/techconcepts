---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../components/site.css';
---

<BaseLayout title="Page not found" description="That page does not exist. Head back to the TechConcepts home page or the Networking Concepts track.">
  <div class="container notfound">
    <h1>That page isn't here</h1>
    <p>The link may be old, or the address may have a typo. Here are two good places to pick up from.</p>
    <p class="notfound__actions">
      <a class="btn btn--primary" href="/">Go to Home</a>
      <a class="btn" href="/networking">Browse Networking Concepts</a>
    </p>
  </div>
</BaseLayout>

<style is:global>
  .notfound {
    max-width: 44rem;
    padding-block: var(--space-8);
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
