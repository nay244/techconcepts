---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../components/site.css';
---

<BaseLayout title="Page not found" description="That page does not exist. Head back to the TechConcepts home page or the Networking Concepts track.">
  <div class="wrap notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1>That page isn't here</h1>
    <p class="notfound__lede">The link may be old, or the address may have a typo. Here are two good places to pick up from.</p>
    <p class="notfound__actions">
      <a class="btn btn--primary" href="/">Go to Home</a>
      <a class="btn" href="/networking">Browse Networking Concepts</a>
    </p>
  </div>
</BaseLayout>

<style is:global>
  .notfound {
    max-width: 44rem;
    padding-block: var(--space-8);
  }
  .notfound__code {
    margin: 0 0 var(--space-3);
    color: var(--accent);
    font: 700 14px/1 var(--mono);
    letter-spacing: 0.12em;
  }
  .notfound h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: -0.01em;
  }
  .notfound__lede {
    max-width: 34rem;
    color: var(--ink);
    font-size: var(--text-lg);
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
