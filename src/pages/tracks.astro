---
// The Tracks page (mockup A, "Card grid", approved 2026-11-07): every track as a card with its cover, its kind, one
// sentence and its lesson count. Once this browser has progress, a card can also show a "Last opened" tab and a ring
// of lessons done; that part runs in the browser, and without JavaScript the page shows a first visit in full.
// Tracks with no lessons yet are listed after the rest, not clickable, flagged "Being written".
import { coverStill, type CoverId } from '../art/figures/covers';
import { cropViewBox } from '../art/ids';
import { trackCards } from '../lib/tracks-page';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCardStatus from '../components/TrackCardStatus';
import '../components/site.css';
import '../components/page-hero.css';

const cards = trackCards();
// The covers as Home's track cards crop them.
const art = (id: CoverId): string => cropViewBox(coverStill(id, `tracks-${id}`), '30 20 540 378');
---

<BaseLayout title="Tracks" current="tracks" description="Every TechConcepts track: sets of short visual lessons, taken in order.">
  <section class="t-hero tp-hero" aria-labelledby="tracks-title">
    <div class="wrap">
      <div class="t-intro">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-current="page">Tracks</span></li>
          </ol>
        </nav>
        <span class="eyebrow"
          ><svg viewBox="0 0 14 10" aria-hidden="true"><polygon points="7,1 13,5 7,9 1,5" fill="currentColor"></polygon></svg>Tracks</span
        >
        <h1 id="tracks-title">Pick a track</h1>
        <p class="lede">
          Each track is a set of short visual lessons, taken in order. Concept tracks explain how things work; certification tracks follow an exam's
          objectives.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap tp-list" aria-labelledby="tracks-title">
    <ul class="tp-grid">
      {
        cards.map((c) => {
          const inner = (
            <>
              <div class="art" aria-hidden="true" set:html={art(c.cover)} />
              {c.flag && <span class="flag">{c.flag}</span>}
              {c.start && <span class="flag start">Start here</span>}
              <div class="body">
                <span class="kind">{c.kind}</span>
                <h2>{c.title}</h2>
                <p>{c.blurb}</p>
                <div class="foot">
                  <span class="count">{c.count}</span>
                  {c.href && <TrackCardStatus client:load trackId={c.id} known={c.known} planned={c.planned} />}
                </div>
              </div>
            </>
          );
          return (
            <li>
              {c.href ? (
                <a class="card tcard" href={c.href}>
                  {inner}
                </a>
              ) : (
                <div class="card tcard later">{inner}</div>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>

<style is:global>
  .tp-hero {
    padding-bottom: 8px;
  }
  .tp-hero .lede {
    max-width: 40em;
  }
  .tp-list {
    padding-top: 32px;
    padding-bottom: 96px;
  }
  .tp-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- A card ---------- */
  /* Positioned, so the "Last opened" tab (drawn inside the foot by the progress island) sits at its top left. */
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-color: var(--line-strong);
    text-decoration: none;
    transition:
      transform 200ms var(--ease-out),
      box-shadow 200ms ease,
      border-color 200ms ease;
  }
  /* Hover and press as Home's track cards. */
  a.tcard {
    color: inherit;
  }
  a.tcard:hover {
    border-color: var(--accent-line);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  a.tcard:active {
    transform: translateY(-1px) scale(0.99);
  }
  .tcard .art {
    height: 200px;
    border-bottom: 1px solid var(--fig-line);
    background: var(--fig-bg);
  }
  .tcard .art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .tcard .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px 20px;
  }
  .tcard .kind {
    color: var(--muted);
    font: 500 12px/1.3 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tcard h2 {
    margin: 0;
    font: 700 22px/1.25 var(--sans);
  }
  .tcard p {
    margin: 0;
    color: var(--ink);
    font-size: 15.5px;
  }
  .tcard .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font: 500 13.5px/1.3 var(--mono);
  }
  /* As tall as the ring, so a card's foot line stays level with its neighbour's whether or not it has one. */
  .tcard .foot .count {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    margin-inline-end: auto;
  }
  .tcard .ring {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .tcard .ring svg {
    width: 22px;
    height: 22px;
  }

  /* The track holding the lesson opened last: a marigold tab and border (marigold is "where you are"). */
  .tcard .tab-here {
    position: absolute;
    top: 0;
    left: 18px;
    z-index: 2;
    padding: 5px 12px 6px;
    border-radius: 0 0 8px 8px;
    background: var(--here);
    color: var(--bg);
    font: 700 12px/1.2 var(--sans);
  }
  .tcard:has(.tab-here) {
    border-color: var(--here);
    box-shadow: 0 0 0 1px var(--here);
  }

  /* A track with no lessons yet. */
  .tcard.later {
    background: var(--card-2);
    box-shadow: none;
  }
  .tcard.later .art .lm-svg {
    opacity: 0.82;
  }
  .tcard .flag {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    padding: 3px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink-strong);
    font: 600 12px/1.4 var(--sans);
  }
  /* The first track is where a newcomer starts: the same pill, in our blue. */
  .tcard .flag.start {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 960px) {
    .tp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
