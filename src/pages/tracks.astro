---
// The Tracks page (spec §6.2, as the adopted insideout-study mockup's Tracks): one wide panel per track, in Home's
// order, each with the id Home's track cards link to. A track's name, who it is for and its art are built here; its
// strip, its Start / Continue button and the card for the lesson up next are the progress island, which shows a first
// visit until this browser's progress has loaded (and in full without JavaScript). A+ has no lessons yet: its panel
// says so, with no link.
import { coverStill, type CoverId } from '../art/figures/covers';
import { cropViewBox } from '../art/ids';
import { STATUS_WORDS } from '../lib/hub';
import { trackCards } from '../lib/tracks-page';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackPanelProgress from '../components/hub/TrackPanelProgress';
import '../components/site.css';
import '../components/hub/hub.css';

// Each track's name with its last word in the accent, as Home sets a lesson's title: 'Networking <em>Concepts</em>'.
const cards = trackCards().map((c) => {
  const cut = c.title.lastIndexOf(' ');
  return { ...c, head: c.title.slice(0, cut + 1), last: c.title.slice(cut + 1) };
});
// A planned track's cover, cropped close to its plate as Home crops it.
const soonArt = (id: CoverId): string => cropViewBox(coverStill(id, `tracks-${id}`), '30 20 540 378');
---

<BaseLayout title="Tracks" current="tracks" description="Every TechConcepts track: sets of short visual lessons, taken in order.">
  <div class="wrap tp">
    <div class="tp-head">
      <h1 class="disp">Pick a <em>track</em></h1>
      <p>Each track is a set of short visual lessons, taken in order.</p>
    </div>

    <div class="panels">
      {
        cards.map((c) =>
          c.ready ? (
            <article class="panel" id={c.id} aria-labelledby={`${c.id}-h`}>
              <h2 class="panel__t disp" id={`${c.id}-h`}>
                <a href={c.href}>{c.head}<em>{c.last}</em></a>
              </h2>
              <p class="panel__who">{c.blurb}</p>
              {/* The island draws the strip, the button row and the up-next card straight into this grid. */}
              <TrackPanelProgress client:load entries={c.entries} known={c.known} trackUrl={c.href}>
                {c.figures.map(({ slot, svg }) => (
                  <Fragment slot={slot} set:html={svg} />
                ))}
              </TrackPanelProgress>
            </article>
          ) : (
            <article class="panel" id={c.id} aria-labelledby={`${c.id}-h`}>
              <h2 class="panel__t disp" id={`${c.id}-h`}>{c.head}<em>{c.last}</em></h2>
              <p class="panel__who">{c.blurb}</p>
              <span class="h-chip h-chip--plain panel__chip">{STATUS_WORDS['not-ready']}</span>
              <div class="panel__cta">
                <span class="btn panel__off">Lessons on the way</span>
              </div>
              <div class="next next--soon">
                <span class="next__art" aria-hidden="true" set:html={soonArt(c.cover)} />
                <span>
                  <span class="next__k">Coming soon</span>
                  <b class="next__t disp">Lesson 1 is being written</b>
                  <span class="next__s">Each lesson will follow the A+ exam objectives.</span>
                </span>
              </div>
            </article>
          ),
        )
      }
    </div>

    <p class="outro">
      {/* One line: Astro drops the space at a line break before a link. */}
      New to IT? Start with <a href="#how-the-internet-works">How the Internet Works</a>, then go deeper with <a href="#networking">Networking Concepts</a>. Every lesson is Watch, Learn, then Practice.
    </p>
  </div>
</BaseLayout>

<style>
  .tp {
    padding-top: 36px;
    padding-bottom: 72px;
  }
  .tp-head {
    margin-bottom: 36px;
  }
  .tp-head h1 {
    font-size: 64px;
  }
  .tp-head p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 17px;
  }

  /* ---------- One panel per track: the track on the left, the lesson up next on the right ---------- */
  .panels {
    display: grid;
    gap: 26px;
  }
  /* The island's parts (the strip, the button row and the card) are grid items here too: Astro's island wrapper is
     display: contents. The left column stacks the name, who it is for, the strip and the buttons; the card takes the
     right column across all four rows. */
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 500px;
    align-content: center;
    column-gap: 40px;
    padding: 40px 44px;
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: var(--shadow-sm);
    /* Home's links to /tracks#<id> land the panel clear of the sticky header (68px), as other pages' anchors do. */
    scroll-margin-top: 92px;
  }
  .panel > :global(*),
  .panel :global(.strip),
  .panel :global(.panel__cta) {
    grid-column: 1;
    min-width: 0;
  }
  .panel :global(.next) {
    grid-column: 2;
    grid-row: 1 / span 4;
  }
  .panel__t {
    font-size: 44px;
  }
  .panel__t a {
    color: inherit;
    text-decoration: none;
  }
  .panel__t a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .panel__who {
    max-width: 560px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
  }
  .panel :global(.strip) {
    margin-top: 26px;
  }

  /* ---------- A+: no lessons yet, so nothing on its panel is a link or a control ---------- */
  .panel__chip {
    justify-self: start;
    margin-top: 26px;
  }
  /* A plain span shaped like a button, muted so it does not read as one to press: no link, no focus, no hover. */
  .panel__off,
  .panel__off:hover {
    border-color: var(--line);
    background: var(--card);
    color: var(--muted);
    cursor: default;
  }
  .panel__off:active {
    transform: none;
  }
  /* Not a link, so not a .lift card: a plain outline at rest, and no hover. */
  .next--soon {
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .next--soon .next__k {
    color: var(--muted);
  }

  .outro {
    max-width: 640px;
    margin: 56px auto 0;
    color: var(--muted);
    font-size: 15px;
    text-align: center;
  }
  .outro a {
    color: var(--ink-strong);
    font-weight: 600;
  }

  /* ---------- Narrow screens: not designed yet (task 8), only kept from breaking ---------- */
  @media (max-width: 1000px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 24px;
    }
    .panel :global(.next) {
      grid-column: 1;
      grid-row: auto;
      margin-top: 26px;
    }
    .panel :global(.panel__cta) {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 560px) {
    .tp-head h1 {
      font-size: 44px;
    }
    .panel__t {
      font-size: 32px;
    }
    /* The words go under the squares rather than squeezing them into a column. */
    .panel :global(.strip) {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .panel :global(.next) {
      flex-direction: column;
      align-items: stretch;
    }
    .panel :global(.next__art) {
      flex-basis: auto;
    }
  }
</style>
