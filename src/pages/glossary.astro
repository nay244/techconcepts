---
// The Glossary page (prototypes/d9-glossary.md): every entry A to Z under the letter keys, each with its written definition,
// the sources it was checked against and the tracks whose lessons describe it. Built from `siteGlossary()`; no island, no script.
import GlossaryEntry from '../components/GlossaryEntry.astro';
import GlossaryKeys from '../components/GlossaryKeys.astro';
import GlossaryStamp from '../components/GlossaryStamp.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteGlossary } from '../lib/glossary-site';
import '../components/site.css';
import '../styles/card-stack.css';

const { letters, keys, stamp } = siteGlossary();
const LEAD = 'Definitions written for this site, each one checked against its sources.';
const NOTE =
  'Under each definition are the sources it was checked against and the tracks whose lessons describe the term. A term with two meanings has a definition for each. New definitions are added once they pass the same check.';
---

<BaseLayout title="Glossary" current="glossary" description={LEAD}>
  <div class="wrap gl">
    <div class="gl-head">
      <h1 class="disp">Glossary</h1>
      <p class="gl-lead">{LEAD}</p>
      <p class="gl-note">{NOTE}</p>
      <GlossaryStamp stamp={stamp} />
    </div>

    <GlossaryKeys keys={keys} />

    {
      letters.map((l) => (
        <section class="gl-letter" id={l.id}>
          <div class="gl-bar">
            <h2>{l.letter}</h2>
            <a class="gl-up" href="#letters">All letters</a>
          </div>
          <dl class="gl-list">
            {l.items.map((item) => <GlossaryEntry item={item} />)}
          </dl>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style is:global>
/* The Glossary in the Card stack look (prototypes/d21-glossary.md, layout 1, Ledger). */

/* Keyboard focus and anchors stay clear of the sticky header (as /tracks and the track pages, E11), and of this
   page's own sticky bar: the page's scroll padding is the header's, each thing that can be scrolled to adds the bar's. */
html { scroll-padding-top: 80px; scroll-padding-bottom: 12px; }
/* The open menu is 391px tall below 960px only: above it the header is 69px again, so the 403px goes with the media query. */
@media (max-width: 959px) {
  html:has(#menu-panel:not([hidden])) { scroll-padding-top: 403px; }
}

.gl { padding-top: 40px; padding-bottom: 80px; }
.gl-head h1 { font-size: 64px; letter-spacing: -0.012em; }
.gl-lead { max-width: 30em; margin: 14px 0 0; color: var(--ink-strong); font-size: 20px; line-height: 1.4; }
.gl-note { max-width: 40em; margin: 10px 0 0; color: var(--ink); font-size: 16px; line-height: 1.55; }
.gl-stamp { margin: 8px 0 0; }
.gl-stamp .stamp { min-height: 44px; font-size: 15px; white-space: normal; }

/* ---- the letters: 26 keys, each a small card. A letter with no term is the look's "not there yet": a dashed edge, not a link. ---- */
.gl-az { margin: 20px 0 0; scroll-margin-top: 4px; }
.gl-az ul { display: grid; grid-template-columns: repeat(13, minmax(0, 1fr)); gap: 6px; margin: 0; padding: 0; list-style: none; }
.gl-key { display: grid; place-items: center; height: 44px; border: 2px solid var(--cs-edge); border-radius: var(--cs-r-in); background: var(--cs-card); color: var(--ink-strong); font: 700 19px/1 var(--display); text-decoration: none; }
a.gl-key:hover { background: var(--cs-quiet); }
a.gl-key:active { transform: translate(1px, 1px); }
.gl-key--none { border-style: dashed; background: none; color: var(--muted); font-weight: 600; }

/* ---- a letter: an index tab on a rule, its card of terms beneath. The tab and "All letters" stay under the header
   while the letter's terms pass, and leave with the card's last row. ---- */
.gl-letter { margin-top: 28px; scroll-margin-top: 0; }
.gl-bar { position: sticky; top: 68px; z-index: 5; display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; height: 48px; margin-inline: -32px; padding-inline: 32px; background: var(--ground); }
.gl-bar::after { content: ''; position: absolute; inset-inline: 32px; bottom: 0; height: 2px; background: var(--cs-edge); }
.gl-bar h2 { position: relative; z-index: 1; display: grid; place-items: center; min-width: 48px; height: 38px; margin: 0; padding: 0 12px; border: 2px solid var(--cs-edge); border-bottom: 0; border-radius: var(--cs-r-in) var(--cs-r-in) 0 0; background: var(--cs-card); font-size: 24px; line-height: 1; }
.gl-up { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 2px; color: var(--ink-strong); font: 600 15px/1 var(--display); letter-spacing: 0.02em; white-space: nowrap; text-decoration-color: var(--cs-hair); text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
/* A stuck bar sits under the header: the ring is drawn inside the link so its top is never under it (D21 cases E12). */
.gl-up:focus-visible { outline-offset: -3px; }
/* A pointer that opens its card has its link flush under the bar (a pointer row has no padding): its ring is drawn inside too, or the bar's paper hides the ring's top. */
.gl-entry--see:first-child .gl-see a:focus-visible { outline-offset: -3px; }

/* ---- the card: one row a term. The rule under the tab is the card's top edge. ---- */
.gl-list { margin: 0; border: 2px solid var(--cs-edge); border-top: 0; border-radius: 0 0 var(--cs-r) var(--cs-r); background: var(--cs-card); }
.gl-entry { padding: 14px 14px 6px; border-top: 1px solid var(--line); scroll-margin-top: 56px; }
.gl-entry:first-child { border-top: 0; }
.gl-entry:last-child { border-radius: 0 0 var(--cs-r-in) var(--cs-r-in); }
.gl-entry dt { margin: 0; }
.gl-name { display: inline-block; max-width: 100%; color: var(--ink-strong); font: 700 20px/26px var(--display); letter-spacing: 0.005em; overflow-wrap: anywhere; }
.gl-also { margin: 2px 0 0; color: var(--muted); font-size: 15px; line-height: 1.4; }
.gl-also b { color: var(--ink); font-weight: 500; }
.gl-entry dd { margin: 0; padding-top: 6px; }
.gl-entry dd + dd { margin-top: 6px; padding-top: 12px; border-top: 1px dashed var(--cs-hair); }
.gl-sense { margin: 0 0 2px; color: var(--ink-strong); font: 700 17px/1.25 var(--display); letter-spacing: 0.01em; }
.gl-def { max-width: 36em; margin: 0; color: var(--ink-strong); font-size: 17px; line-height: 26px; }
/* the two lines under a definition. Each link is 44px tall to a finger. */
.gl-row { margin: 0; color: var(--muted); font: 600 15px/20px var(--display); letter-spacing: 0.02em; }
.gl-row a { display: inline-block; max-width: 100%; padding-block: 12px; scroll-margin-top: 56px; }
.gl-row .gl-label { margin-inline-end: 4px; }
/* Card stack's links: ink with an underline, as on Home, Tracks and the track page. */
a.gl-src, .gl-see a { color: var(--ink-strong); text-decoration-color: var(--cs-hair); text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
a.gl-src:hover, .gl-see a:hover, .gl-up:hover { text-decoration-color: currentColor; }
.gl-row--tracks { padding-block: 3px; }
.gl-tracks { color: var(--ink); }
/* another spelling, filed at its own letter: one line, the spelling then where to look */
.gl-entry--see, .gl-entry--see:first-child { display: flex; flex-wrap: wrap; align-items: center; column-gap: 12px; padding-block: 0; }
.gl-name--see { color: var(--ink); font-weight: 600; font-size: 18px; }
.gl-entry--see dd { padding-top: 0; }
/* where you landed: orange is "here" */
.gl-entry:target { background: var(--cs-here-wash); box-shadow: inset 4px 0 0 var(--cs-here); }

@media (min-width: 640px) {
  .gl-entry, .gl-entry:first-child { display: grid; grid-template-columns: 180px minmax(0, 1fr); column-gap: 24px; align-items: start; padding: 14px 20px 8px; }
  .gl-entry dt { grid-row: 1 / span 9; }
  .gl-entry dd { grid-column: 2; padding-top: 0; }
  .gl-entry dd + dd { margin-top: 8px; padding-top: 14px; }
  .gl-entry--see, .gl-entry--see:first-child { align-items: center; padding-block: 0; }
}
@media (min-width: 960px) {
  .gl-entry, .gl-entry:first-child { grid-template-columns: 220px minmax(0, 1fr); padding-block: 14px; }
  .gl-entry dd { display: grid; grid-template-columns: minmax(0, 1fr) 220px; column-gap: 24px; align-items: start; }
  .gl-entry dd + dd { margin-top: 14px; }
  .gl-entry--see, .gl-entry--see:first-child { padding-block: 0; }
  .gl-entry--see dd { display: block; }
}
@media (min-width: 1200px) {
  .gl-entry, .gl-entry:first-child { grid-template-columns: 280px minmax(0, 1fr); column-gap: 32px; }
  .gl-entry dd { grid-template-columns: minmax(0, 1fr) 300px; column-gap: 32px; }
}
/* With a mouse, from 960px, the two lines close up: a link is 26px tall. A finger keeps 44px at every width. */
@media (min-width: 960px) and (pointer: fine) {
  .gl-row a { padding-block: 3px; }
  .gl-row + .gl-row { margin-top: 4px; }
  .gl-entry--see .gl-row a { padding-block: 7px; }
}
/* ---- from 1280px the 26 keys fit one row and stay under the header; a letter's tab then scrolls with its card ---- */
@media (min-width: 1280px) {
  .gl-az { position: sticky; top: 68px; z-index: 6; margin-inline: -32px; padding: 10px 32px; border-bottom: 1px solid var(--cs-hair); background: var(--ground); }
  .gl-az ul { grid-template-columns: repeat(26, minmax(0, 1fr)); gap: 2px; }
  .gl-bar { position: relative; top: auto; }
  .gl-up { display: none; }
  .gl-letter { scroll-margin-top: 58px; }
  .gl-entry, .gl-row a { scroll-margin-top: 66px; }
}
/* ---- a phone ---- */
@media (max-width: 599px) {
  .gl { padding-top: 28px; padding-inline: 14px; }
  .gl-head h1 { font-size: 44px; }
  .gl-lead { font-size: 18px; }
  .gl-az ul { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 5px; }
  .gl-bar { margin-inline: -14px; padding-inline: 14px; }
  .gl-bar::after { inset-inline: 14px; }
}
@media (max-width: 374px) {
  .gl-az ul { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; }
}
</style>
