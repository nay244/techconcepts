---
// Home (docs/direction.md §9). The page is a small lesson: under the headline a visitor can step through lesson 1,
// how a web page arrives over HTTP, read its Learn part and answer its first question, all without a script. Then
// come the tracks to begin with, where the facts come from, and the way into lesson 1.
// Every lesson word and every number is worked out from the content when the page is built (src/lib/home.ts).
// Nothing reads progress: a returning visitor sees the same page.
import { coverStill, type CoverId } from '../art/figures/covers';
import { pageFigure } from '../art/figures/pages';
import { cropViewBox } from '../art/ids';
import { factCheckSentence } from '../lib/about';
import { lessonCheckCounts } from '../lib/checked';
import { foldSources, homeDemo, homeStops, litSteps } from '../lib/home';
import { startLesson } from '../lib/start';
import Rich from '../lesson/Rich';
import Stamp from '../components/Stamp';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../art/scenes/net-map.css';
import '../components/site.css';

const start = startLesson();
const demo = homeDemo();
const stops = homeStops();
const checks = lessonCheckCounts();
const factCheck = factCheckSentence(checks.checked, checks.total);

const PARTS = ['watch', 'learn', 'practice'] as const;
const PART_WORDS = { watch: 'Watch', learn: 'Learn', practice: 'Practice' } as const;
const last = demo.steps.length;
// Learn's foot (prototypes/d5-home-sources.md): the stamp, the first three sources, and the rest behind a <details>.
const { shown, folded } = foldSources(demo.learn.sources);
const List = demo.learn.numbered ? 'ol' : 'ul';

// A cover, cropped close to its plate. Each copy on the page tags its own ids.
const coverArt = (id: CoverId): string => cropViewBox(coverStill(id, `home-${id}`), '30 20 540 378');

// ---------- The demo's states, as CSS ----------
// The demo is three groups of radio buttons (the part, the step, the answer) that come before its panel, so a checked
// button can show, hide and light things in the panel with the sibling selector alone. The scene's own parts are
// switched the same way; where its driver would set an inline `opacity:0`, the rule is !important.
const UI = '.demo__ui';
const when = (...ids: string[]): string => `${ids.map((id) => `#${id}:checked`).join(' ~ ')} ~ ${UI}`;
const focus = (id: string): string => `#${id}:focus-visible ~ ${UI} label[for="${id}"]{outline:2px solid var(--focus);outline-offset:2px}`;
// Before any step: no way is lit, and the laptop's screen is empty. (The map is drawn with the page loaded, and a
// lesson's driver clears it when it starts; here the first rule does.)
const css: string[] = ['.home-trail{opacity:0;transition:opacity 200ms ease}', `${UI} #nm-page [data-part]{opacity:0}`];
for (const part of PARTS) {
  css.push(`${when(`demo-${part}`)} .demo__pane--${part}{display:block}`);
  css.push(`${when(`demo-${part}`)} .demo__parts label[for="demo-${part}"]{background:var(--card);color:var(--ink-strong);box-shadow:inset 0 -2px 0 var(--here)}`);
  css.push(focus(`demo-${part}`));
}
for (const step of demo.steps) {
  const id = `demo-s${step.n}`;
  css.push(`${when(id)} .demo__say--${step.n}{display:block}`);
  css.push(`${when(id)} .demo__next--${step.n}{display:inline-flex}`);
  css.push(`${when(id)} .demo__row[for="${id}"]{border-color:var(--here);background:var(--here-soft)}`);
  css.push(`${when(id)} .demo__row[for="${id}"] .demo__n{border-color:var(--here);color:var(--here)}`);
  // The steps before the one you are on are done.
  for (const done of demo.steps.filter((s) => s.n < step.n)) {
    css.push(`${when(id)} .demo__row[for="demo-s${done.n}"] .demo__n{border-color:var(--allowed);background:var(--allowed);color:var(--accent-ink)}`);
  }
  css.push(focus(id));
  // The way the step's messages take lights up, and so does everything at work on it.
  if (step.lights.trail) css.push(`${when('demo-watch', id)} .home-trail[data-step="${step.n}"]{opacity:.9}`);
  css.push(`${step.lights.busy.map((busy) => `${when('demo-watch', id)} #${busy}`).join(',')}{opacity:1}`);
}
// The page on the laptop follows the lesson's own cues (src/lib/home.ts): its words are lit from the first step that
// has a page cue, its pictures from the first with page: 'full', and they stay through Learn and Practice.
const lit = litSteps(demo.page, last);
const litWhen = (on: { steps: number[]; parts: string[] }): string[] => [
  ...on.steps.map((n) => when('demo-watch', `demo-s${n}`)),
  ...on.parts.map((part) => when(`demo-${part}`)),
];
css.push(`${litWhen(lit.words).map((s) => `${s} #nm-page [data-part="text"]`).join(',')}{opacity:1!important}`);
css.push(`${litWhen(lit.pictures).map((s) => `${s} #nm-page [data-part="pic"]`).join(',')}{opacity:1!important}`);
demo.practice.options.forEach((option, i) => {
  const id = `demo-a${i + 1}`;
  css.push(`${when(id)} .demo__why--${i + 1}{display:block}`);
  css.push(`${when(id)} .demo__pick[for="${id}"]{border-color:var(--${option.right ? 'allowed' : 'line-strong'});background:var(--card-2)}`);
  css.push(focus(id));
});
---

<BaseLayout
  title="TechConcepts"
  description="Short visual lessons on how technology works. Watch a real exchange play one step at a time, read what happened in plain words, then try a few questions. Free, with no account."
>
  <section class="open wrap" aria-labelledby="home-title">
    <h1 id="home-title">See how technology really works.</h1>
    <div class="open__side">
      <p class="open__say">Short lessons you watch first. Each one plays a real exchange a step at a time, then says what happened in plain words.</p>
      <div class="open__acts">
        <a class="btn btn--primary" href={start.url}>Start with lesson 1: {start.title}</a>
        <a class="btn" href="/tracks">See the tracks</a>
      </div>
      <p class="open__facts">Free. No account. Your progress stays in this browser.</p>
    </div>
  </section>

  <section class="try wrap" id="try" aria-labelledby="try-title">
    <header class="try__head">
      <h2 id="try-title">Try one, right here</h2>
      <p>
        A browser asks a web server for a page. This is lesson {demo.lesson.number} of {demo.lesson.track}, <a href={demo.lesson.url}>{demo.lesson.title}</a>.
      </p>
    </header>

    <div class="demo">
      <style is:inline set:html={css.join('\n')}></style>
      {PARTS.map((part, i) => <input class="demo__in" type="radio" name="demo-part" id={`demo-${part}`} checked={i === 0} aria-label={`${PART_WORDS[part]} part`} />)}
      {
        demo.steps.map((step) => (
          <input class="demo__in" type="radio" name="demo-step" id={`demo-s${step.n}`} checked={step.n === 1} aria-label={`Watch, step ${step.n} of ${last}: ${step.title}`} />
        ))
      }
      {demo.practice.options.map((option, i) => <input class="demo__in" type="radio" name="demo-answer" id={`demo-a${i + 1}`} aria-label={`Answer: ${option.text}`} />)}

      <div class="demo__ui">
        <div class="demo__parts" aria-hidden="true">
          {PARTS.map((part) => <label for={`demo-${part}`}>{PART_WORDS[part]}</label>)}
        </div>

        <figure class="demo__scene">
          <Fragment set:html={demo.scene} />
        </figure>

        <div class="demo__pane demo__pane--watch">
          <ol class="demo__rows" aria-hidden="true">
            {
              demo.steps.map((step) => (
                <li>
                  <label class="demo__row" for={`demo-s${step.n}`}>
                    <span class="demo__n">{step.n}</span>
                    <span>
                      <b>{step.title}</b>
                      <small>{step.sub}</small>
                    </span>
                  </label>
                </li>
              ))
            }
          </ol>
          <div class="demo__says" aria-live="polite">
            {
              demo.steps.map((step) => (
                <div class={`demo__say demo__say--${step.n}`}>
                  <p>
                    <Rich text={step.narrative} />
                  </p>
                  {step.messages.length > 0 && (
                    <ul class="demo__msgs">
                      {step.messages.map((m) => (
                        <li data-kind={m.kind}>
                          <span>
                            {m.from} to {m.to}
                          </span>
                          <b>{m.tag}</b>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))
            }
          </div>
          <div class="demo__nexts" aria-hidden="true">
            {
              demo.steps.map((step) =>
                step.n < last ? (
                  <label class={`btn btn--primary demo__next demo__next--${step.n}`} for={`demo-s${step.n + 1}`}>
                    Next step
                  </label>
                ) : (
                  <label class={`btn btn--primary demo__next demo__next--${step.n}`} for="demo-learn">
                    Go to Learn
                  </label>
                ),
              )
            }
          </div>
        </div>

        <div class="demo__pane demo__pane--learn">
          <p class="demo__lead"><Rich text={demo.learn.lead} /></p>
          <dl class="demo__terms">
            {
              demo.learn.terms.map((term) => (
                <div>
                  <dt>{term.idea}</dt>
                  <dd>{term.name}</dd>
                </div>
              ))
            }
          </dl>
          <p class="demo__sealed">
            <b>And {demo.sealed.title}?</b>
            <Rich text={demo.sealed.lead} />
            <a href={demo.sealed.url}>
              Lesson {demo.sealed.number}: {demo.sealed.title}
            </a>
          </p>
          <div class="demo__src">
            <p class="demo__stamp"><Stamp stamp={demo.learn.stamp} /></p>
            {
              shown.length > 0 && (
                <List class="demo__list" role="list" aria-label="Sources">
                  {shown.map((source, i) => (
                    <li>
                      {demo.learn.numbered && <span class="demo__num">{i + 1}</span>}
                      <a href={source.url} title={source.label}>{source.name}</a>
                    </li>
                  ))}
                </List>
              )
            }
            {
              folded.length > 0 && (
                <details class="demo__more">
                  <summary>
                    <span class="demo__closed">Show the other {folded.length}</span>
                    <span class="demo__open">Hide the other {folded.length}</span>
                  </summary>
                  <List class="demo__list" role="list" start={demo.learn.numbered ? shown.length + 1 : undefined} aria-label={`Sources ${shown.length + 1} to ${demo.learn.sources.length}`}>
                    {folded.map((source, i) => (
                      <li>
                        {demo.learn.numbered && <span class="demo__num">{shown.length + i + 1}</span>}
                        <a href={source.url} title={source.label}>{source.name}</a>
                      </li>
                    ))}
                  </List>
                </details>
              )
            }
          </div>
          <div class="demo__nexts" aria-hidden="true">
            <label class="btn btn--primary demo__next demo__next--on" for="demo-practice">Go to Practice</label>
          </div>
        </div>

        <div class="demo__pane demo__pane--practice">
          <p class="demo__lead">{demo.practice.prompt}</p>
          <div class="demo__picks" aria-hidden="true">
            {
              demo.practice.options.map((option, i) => (
                <label class="demo__pick" for={`demo-a${i + 1}`}>
                  {option.text}
                </label>
              ))
            }
          </div>
          <div aria-live="polite">
            {
              demo.practice.options.map((option, i) => (
                <p class={`demo__why demo__why--${i + 1}`} data-right={option.right ? '' : undefined}>
                  <Rich text={option.feedback} />
                </p>
              ))
            }
          </div>
          <p class="demo__after">
            Nothing is scored. <a href={demo.lesson.url}>Open the whole lesson</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="order" aria-labelledby="order-title">
    <div class="wrap">
      <h2 id="order-title">Get started with the basics</h2>
      <ol class="cable">
        {
          stops.map((stop) => (
            <li class="leg">
              <div class="leg__art" aria-hidden="true">
                <Fragment set:html={coverArt(stop.cover)} />
              </div>
              <p class="leg__order">{stop.order}</p>
              <h3>
                <a href={stop.href}>{stop.title}</a>
              </h3>
              <p class="leg__blurb">{stop.blurb}</p>
              <p class="leg__count">
                <span class="leg__run" aria-hidden="true">
                  {Array.from({ length: stop.lessons.planned }, (_, i) => (
                    <i data-ready={i < stop.lessons.ready ? '' : undefined} />
                  ))}
                </span>
                {stop.count}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="facts" id="sources" aria-labelledby="facts-title">
    <div class="wrap facts__grid">
      <div class="facts__art" aria-hidden="true">
        <Fragment set:html={pageFigure('sources')} />
      </div>
      <div>
        <h2 id="facts-title">Where the facts come from</h2>
        <p>Each lesson lists the standards it draws on under Sources at the end of Learn. {factCheck}</p>
        <p><a href="/about#facts">How a lesson is made and checked</a></p>
      </div>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="wrap close__grid">
      <div>
        <h2 id="close-title">Lift the lid</h2>
        <p>Lesson 1 is {start.title}: what happens when you ask for a web page. You can stop anywhere and pick it up later.</p>
        <a class="btn btn--primary" href={start.url}>Start with lesson 1: {start.title}</a>
      </div>
      <div class="close__art" aria-hidden="true">
        <Fragment set:html={pageFigure('inside')} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
  h2 {
    margin: 0;
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.05;
  }
  section[id] {
    /* Clear of the sticky header when a link lands here. */
    scroll-margin-top: 88px;
  }

  /* ---------- The opening: the line, set large, and what to do about it ---------- */
  .open {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px clamp(24px, 4vw, 64px);
    align-items: end;
    padding-top: clamp(36px, 6vw, 88px);
    padding-bottom: clamp(28px, 4vw, 48px);
  }
  .open h1 {
    margin: 0;
    font-size: clamp(52px, 9.2vw, 132px);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .open__say {
    margin: 0;
    max-width: 34em;
    color: var(--ink-strong);
    font-size: 19px;
    line-height: 1.5;
  }
  .open__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .open__facts {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  /* ---------- The demo: a lesson in small, switched by radio buttons alone ---------- */
  .try {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .try__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 20px;
    padding: 16px 0 14px;
    border-top: 2px solid var(--ink-strong);
  }
  .try__head h2 {
    font-size: 26px;
  }
  .try__head p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
  }
  .try__head a {
    color: var(--link);
  }
  .demo {
    position: relative;
  }
  /* The radio buttons are out of sight, and still reached by Tab and the arrow keys. */
  .demo__in {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .demo__ui {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(300px, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas: 'scene parts' 'scene pane';
    border: 1px solid var(--line-strong);
    border-radius: var(--r-card);
    background: var(--card);
    overflow: hidden;
  }
  .demo__parts {
    grid-area: parts;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--line-strong);
    background: var(--bg-soft);
  }
  .demo__parts label {
    display: grid;
    place-items: center;
    min-height: 48px;
    color: var(--ink);
    font: 600 17px/1 var(--display);
    letter-spacing: 0.01em;
    cursor: pointer;
  }
  .demo__parts label + label {
    border-left: 1px solid var(--line);
  }
  .demo__scene {
    grid-area: scene;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 12px;
    border-right: 1px solid var(--line-strong);
    background: var(--fig-bg);
  }
  .demo__scene :global(svg) {
    width: 100%;
    max-height: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo__scene :global(*) {
      transition: none !important;
    }
  }
  .demo__pane {
    grid-area: pane;
    display: none;
    /* Tall enough for the longest part, so the scene beside it keeps its size as the parts change. */
    min-height: 452px;
    padding: 16px 18px 18px;
  }
  .demo__rows {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .demo__row {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 10px;
    align-items: start;
    padding: 6px 8px;
    border: 1px solid transparent;
    border-radius: 3px;
    cursor: pointer;
  }
  .demo__n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    background: var(--card);
    color: var(--muted);
    font: 700 12px/1 var(--mono);
  }
  .demo__row b {
    display: block;
    color: var(--ink-strong);
    font: 600 16.5px/1.25 var(--display);
  }
  .demo__row small {
    display: block;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
  }
  .demo__says {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .demo__say,
  .demo__why {
    display: none;
    margin: 0;
    color: var(--ink-strong);
    font-size: 16px;
    line-height: 1.5;
  }
  .demo__say p {
    margin: 0;
  }
  /* What the step sends: who to whom, and the words on the message. A request is the blue pair, a reply the brown. */
  .demo__msgs {
    display: grid;
    gap: 4px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14.5px;
  }
  .demo__msgs li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 5px 8px 5px 10px;
    border-left: 3px solid var(--request);
    background: var(--card-2);
    color: var(--ink);
  }
  .demo__msgs li[data-kind='response'] {
    border-left-color: var(--response);
  }
  .demo__msgs b {
    color: var(--ink-strong);
    font: 700 13px/1.6 var(--mono);
    white-space: nowrap;
  }
  .demo__sealed {
    margin: 14px 0 0;
    padding: 10px 12px;
    border-left: 3px solid var(--encrypted);
    background: var(--card-2);
    font-size: 15px;
    line-height: 1.45;
  }
  .demo__sealed b {
    display: block;
    color: var(--ink-strong);
    font: 600 16px/1.3 var(--display);
  }
  .demo__sealed a {
    display: block;
    margin-top: 4px;
    color: var(--link);
  }
  .demo__nexts {
    margin-top: 14px;
  }
  .demo__next {
    display: none;
  }
  .demo__next--on {
    display: inline-flex;
  }
  .demo__lead {
    margin: 0;
    color: var(--ink-strong);
    font-size: 17px;
    line-height: 1.5;
  }
  .demo__terms {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
  }
  .demo__terms div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.4;
  }
  .demo__terms dd {
    margin: 0;
    color: var(--ink-strong);
    font: 600 16px/1.3 var(--display);
  }
  .demo__after {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14.5px;
  }
  .demo__after a,
  .facts a {
    color: var(--link);
  }
  /* ---- D5: Learn's foot. The lesson's stamp, then its sources by their short names. ---- */
  .demo__src { margin: 12px 0 0; }
  .demo__stamp { margin: 0; line-height: 1; }
  .demo__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 10px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
    font: 400 14.5px/1.3 var(--sans);
  }
  /* A numbered list keeps the lesson's numbers, in a gutter as wide as the stamp's mark and its gap. */
  .demo__list > li { display: grid; grid-template-columns: 15px minmax(0, 1fr); column-gap: 6px; align-items: center; min-height: 28px; }
  ul.demo__list { padding-left: 21px; }
  ul.demo__list > li { grid-template-columns: minmax(0, 1fr); }
  .demo__num { color: var(--muted); font: 600 12px/1 var(--mono); text-align: right; }
  .demo__list a { justify-self: start; padding: 4px 0; color: var(--link); text-underline-offset: 2px; overflow-wrap: anywhere; }
  .demo__more { margin: 4px 0 0; }
  .demo__more > summary {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    border-top: 1px solid var(--line);
    color: var(--ink-strong);
    font: 600 15px/1.2 var(--display);
    letter-spacing: 0.01em;
    list-style: none;
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
  }
  .demo__more > summary::-webkit-details-marker { display: none; }
  /* A small square with a plus, a minus once open: the family's marker, in line with the stamp's ring. */
  .demo__more > summary::before {
    content: '';
    flex: none;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--line-strong);
    border-radius: 2px;
    background:
      linear-gradient(var(--ink-strong), var(--ink-strong)) center / 7px 1.5px no-repeat,
      linear-gradient(var(--ink-strong), var(--ink-strong)) center / 1.5px 7px no-repeat;
  }
  .demo__more[open] > summary::before {
    background: linear-gradient(var(--ink-strong), var(--ink-strong)) center / 7px 1.5px no-repeat;
  }
