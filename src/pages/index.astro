---
import { CERT_TAGS, type CertTag } from '../content/certs';
import { getEntries, trackTotals, type AvailableSummary } from '../content/registry';
import { comingSoonTracks, tracks } from '../content/tracks';
import { levelLabel } from '../lib/entries';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackProgress from '../components/TrackProgress';
import '../components/site.css';

const track = tracks[0]!;
const entries = getEntries(track.id);
const available = entries.filter((e): e is AvailableSummary => e.available);
const { planned, minutes } = trackTotals(entries);
// Start at the first lesson that is written, or at the track page while none is.
const startUrl = available[0]?.url ?? `/${track.id}`;

const present = new Set(available.flatMap((e) => e.certTags));
const certTags = (Object.keys(CERT_TAGS) as CertTag[]).filter((tag) => present.has(tag));

const level = levelLabel(track.level);

const steps = [
  { name: 'Watch', line: 'See it happen. Devices send messages to one another, one step at a time, and you can go forward and back at your own pace.' },
  { name: 'Learn', line: 'Find out what happened and why, in plain words. Each idea comes first, then its technical name, and a Go deeper section holds the exam-level detail.' },
  { name: 'Practice', line: 'Answer a few questions to see what stuck. They are just for you: nothing is scored or saved.' },
];
---

<BaseLayout title="TechConcepts" description="Short, visual lessons that show how technology works, starting with networking. Watch it happen, learn what it is called, then practice.">
  <div class="container home">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">See how technology works, one short lesson at a time.</h1>
      <p class="hero__lede">Watch a network do its job, learn what each part is called, then check what stuck. Most lessons take 15 minutes or less, and there is nothing to sign up for.</p>
      <div class="hero__actions">
        <a class="btn btn--primary hero__start" href={startUrl}>Start with {track.title}</a>
      </div>
    </section>

    <section aria-labelledby="tracks-title" class="home__section">
      <h2 id="tracks-title">Tracks</h2>
      <ul class="cards" role="list">
        <li class="card">
          <h3 class="card__title"><a href={`/${track.id}`}>{track.title}</a></h3>
          <p>{track.description}</p>
          <ul class="card__stats" role="list">
            <li>{available.length} of {planned} lessons ready</li>
            <li>{minutes} min in total</li>
            <li>{level}</li>
          </ul>
          <TrackProgress client:load entries={entries} planned={planned} />
        </li>
        {
          comingSoonTracks.map((t) => (
            <li class="card card--soon">
              <h3 class="card__title">{t.title}</h3>
              <p>{t.blurb}</p>
              <p class="card__soon">Coming soon</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="prep-title" class="home__section">
      <h2 id="prep-title">Preparing for&hellip;</h2>
      <p class="home__note">Pick a certification or role to see the lessons that help.</p>
      <ul class="chips" role="list">
        {
          certTags.map((tag) => (
            <li>
              <a class="chip" href={`/${track.id}?for=${tag}`}>{CERT_TAGS[tag]}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="how-title" class="home__section">
      <h2 id="how-title">How a lesson works</h2>
      <ol class="how" role="list">
        {
          steps.map((s, i) => (
            <li class="how__step">
              <span class="how__num" aria-hidden="true">{i + 1}</span>
              <h3 class="how__name">{s.name}</h3>
              <p>{s.line}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .home {
    padding-block: var(--space-7) var(--space-4);
  }
  .home__section {
    margin-top: var(--space-8);
  }
  .home__note {
    max-width: var(--measure);
    color: var(--muted);
  }
  .hero h1 {
    max-width: 22ch;
    margin-bottom: var(--space-4);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.25rem);
    letter-spacing: -0.02em;
  }
  .hero__lede {
    max-width: var(--measure);
    font-size: var(--text-lg);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-3);
    margin-top: var(--space-5);
    align-content: flex-start;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .card:first-child {
    border-color: var(--line-strong);
    grid-column: 1 / -1;
    max-width: 48rem;
  }
  .card__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }
  .card__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .card--soon {
    border-style: dashed;
    background: transparent;
    color: var(--muted);
  }
  .card--soon .card__title {
    color: var(--muted);
  }
  .card__soon {
    margin: auto 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .how {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .how__step {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .how__num {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .how__name {
    margin-bottom: var(--space-2);
  }
  .how__step p {
    margin: 0;
  }
</style>
