---
// Home (spec §6.1), as the adopted insideout-study mockup's Home. Every number and every lesson word on it is worked
// out from the tracks and lessons when the page is built (src/lib/home.ts); the art is the site's own covers, spots and
// the OSI Model lesson's figure. Nothing on it reads progress: a returning visitor sees the same page.
import { coverStill, type CoverId } from '../art/figures/covers';
import { spot } from '../art/figures/spots';
import { cropViewBox } from '../art/ids';
import { homeTrackCards, insideSheet } from '../lib/home';
import { startLesson } from '../lib/start';
import Rich from '../lesson/Rich';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../components/site.css';

const start = startLesson();
const cards = homeTrackCards();
const sheet = insideSheet();

// A cover, cropped close to its plate. Each copy on the page tags its own ids.
const coverArt = (id: CoverId, tag: string): string => cropViewBox(coverStill(id, `home-${tag}-${id}`), '30 20 540 378');

// The lesson's title with its last word in the accent, as the mockup sets "OSI Model".
const cut = sheet.title.lastIndexOf(' ');
const titleHead = cut === -1 ? '' : sheet.title.slice(0, cut + 1);
const titleLast = sheet.title.slice(cut + 1);

const parts = [
  {
    kind: 'watch',
    word: 'Watch',
    rest: ' it happen',
    text: 'Devices send messages to one another, one step at a time, and you can go forward and back at your own pace.',
    button: 'See a Watch part →',
    href: sheet.parts.watch,
  },
  {
    kind: 'learn',
    word: 'Learn',
    rest: ' what happened',
    text: 'Find out what happened and why, in plain words. Each idea comes first, then its technical name, and a Go deeper section holds the exam-level detail.',
    button: 'See a Learn part →',
    href: sheet.parts.learn,
  },
  {
    kind: 'practice',
    word: 'Practice',
    rest: ' what stuck',
    text: 'Answer a few questions to see what stuck. Nothing is scored or saved.',
    button: 'See a Practice part →',
    href: sheet.parts.practice,
  },
] as const;

// Drafted for the owner's approval (spec §6.1): each answer says only what is true of the site today.
const questions = [
  {
    q: 'Where do I start?',
    a: 'With How the Internet Works. It is the first of the three tracks, and the button at the top of this page opens its first lesson.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. There is nothing to sign up for. Your progress is saved in this browser only, and you can clear it any time.',
  },
  {
    q: 'Where do the facts come from?',
    a: 'From published sources, mostly the standards that say how each protocol works, such as RFCs. Every lesson lists its sources, with links, under Go deeper in its Learn part.',
  },
  { q: 'Is Practice scored?', a: 'No. Practice is just for you. Nothing is scored or saved.' },
];
---

<BaseLayout
  title="TechConcepts"
  description="Short, visual lessons on networks, the web, security and AI. Watch each idea happen one step at a time, explained in plain words."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-art hero-art--l" aria-hidden="true" set:html={coverArt('web', 'hero')} />
    <div class="hero-art hero-art--l2" aria-hidden="true" set:html={coverArt('aplus', 'hero')} />
    <div class="hero-art hero-art--r" aria-hidden="true" set:html={coverArt('networking', 'hero')} />
    <div class="hero-copy">
      <span class="h-chip hero-chip">Free visual lessons, no sign-up</span>
      <h1 id="hero-title" class="disp">See how technology <span class="accent">really works.</span></h1>
      <p class="hero-sub">Short, visual lessons on networks, the web, security and AI. Watch each idea happen one step at a time, explained in plain words.</p>
      <div class="hero-actions">
        <a class="btn btn--primary btn--lg" href={start.url}>Learn how the Internet Works</a>
        <a class="h-link" href="#inside">See a lesson</a>
      </div>
    </div>
  </section>

  <section class="band" id="tracks" aria-labelledby="tracks-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="tracks-title" class="disp">Choose where to <em>start.</em></h2>
        <p>Three tracks, in the order to take them.</p>
      </div>
      <ul class="home-tracks">
        {
          cards.map((card) => (
            <li>
              <a class="home-track lift" href={card.href}>
                <div class="home-track__art" aria-hidden="true" set:html={coverArt(card.cover, 'card')} />
                <div class="home-track__body">
                  <div class="home-track__meta">
                    {card.chips.map((chip) => (
                      <span class:list={['h-chip', { 'h-chip--plain': chip.plain }]}>{chip.text}</span>
                    ))}
                  </div>
                  <h3 class="disp">{card.title}</h3>
                  <p>{card.blurb}</p>
                  <div class="home-track__foot">
                    <span class="home-track__count">{card.count}</span>
                    <span class:list={['btn', 'btn--small', 'home-track__go', { 'btn--primary': card.ready }]}>{card.go}</span>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band--after" id="inside" aria-labelledby="inside-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="inside-title" class="disp">See a lesson from the <em>inside.</em></h2>
        <p>One message, from your laptop to a web server, a layer at a time.</p>
      </div>
      <div class="sheet">
        <div class="sheet__page">
          <p class="label sheet__label">{sheet.label}</p>
          <h3 class="disp">{titleHead}<em>{titleLast}</em></h3>
          <p class="sheet__hook"><Rich text={sheet.hook} /></p>
          <div class="ex">
            <p class="label label--here ex__head">Watch · steps 1 to {sheet.steps.length}</p>
            <ol class="sheet__steps">
              {
                sheet.steps.map((step) => (
                  <li>
                    <span class="n">{step.n}</span>
                    <span>
                      <b class="t">{step.title}</b>
                      <span class="s">{step.sub}</span>
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
        <div class="sheet__page sheet__page--fig">
          <div class="sheet__head"><span class="label">{sheet.scene}</span><span class="label">fig. 1</span></div>
          <div class="sheet__fig" set:html={sheet.figure} />
        </div>
      </div>
      <p class="sheet__more"><a class="h-link" href={sheet.url}>Open the whole lesson →</a></p>
    </div>
  </section>

  <section class="band band--after" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-title" class="disp">Watch, learn, <em>then practice.</em></h2>
        <p>Three parts, always in this order.</p>
      </div>
      <div class="feats">
        {
          parts.map((part, i) => (
            <article class="feat">
              <div class="feat__art" aria-hidden="true" set:html={spot(part.kind)} />
              <div class="feat__copy">
                <span class="label">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="disp"><em>{part.word}</em>{part.rest}</h3>
                <p>{part.text}</p>
                <a class="btn btn--primary" href={part.href}>{part.button}</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="free-title">
    <div class="wrap">
      <div class="free">
        <div class="free__l">
          <h2 id="free-title" class="disp">Nothing to <em>sign up for.</em></h2>
          <p>No account and no email. Your progress is saved in this browser only, and you can clear it any time.</p>
        </div>
        <div class="free__r">
          <ul class="ticks">
            <li>Every lesson, free</li>
            <li>No account, no email</li>
            <li>Progress stays in this browser</li>
            <li>Every lesson links to its sources</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--faq" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="faq-title" class="disp">Questions</h2>
      </div>
      <div class="faq">
        {
          questions.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  /* ---------- Shared on this page (the display heading, the label and the chip are site.css's) ---------- */
  .h-link {
    color: var(--ink-strong);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
  }
  .h-link:hover {
    text-decoration-color: currentColor;
  }
  .btn--lg {
    min-height: 56px;
    padding: 0 26px;
    font-size: 17px;
  }
  .band {
    padding: 110px 0;
  }
  /* A section the header links to lands clear of the sticky header (68px), as About's and the track page's do. */
  .band[id] {
    scroll-margin-top: 92px;
  }
  .band--after {
    padding-top: 20px;
  }
  .band--faq {
    padding-top: 0;
  }
  .section-head {
    max-width: 720px;
    margin: 0 auto 44px;
    text-align: center;
  }
  .section-head h2 {
    font-size: 44px;
  }
  .section-head p {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 18.5px;
  }

  /* ---------- Hero: the words in the middle, three covers around them ---------- */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100vh - 68px);
    padding: 40px 32px 80px;
    overflow: hidden;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 760px;
    text-align: center;
  }
  .hero-chip {
    margin-bottom: 26px;
  }
  .hero h1 {
    font-size: 80px;
  }
  .hero-sub {
    max-width: 470px;
    margin: 26px auto 0;
    color: var(--ink);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.48;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    margin-top: 34px;
  }
  .hero-art {
    position: absolute;
    z-index: 1;
    /* 236px at 1280 and 302px at 1440, so the covers beside the title keep 32px or more clear of it; 330px from 1508. */
    width: clamp(200px, calc(41.25vw - 292px), 330px);
    pointer-events: none;
  }
  .hero-art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-art--l {
    top: 12%;
    left: max(1vw, calc(50% - 720px));
  }
  .hero-art--l2 {
    top: 56%;
    left: max(1vw, calc(50% - 690px));
    width: clamp(180px, 17vw, 270px);
  }
  .hero-art--r {
    top: 22%;
    right: max(1vw, calc(50% - 720px));
  }

  /* ---------- Tracks ---------- */
  .home-tracks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-track {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--card);
    /* Its shadow, resting and on hover, is .lift's (site.css). */
    color: inherit;
    text-decoration: none;
  }
  .home-track__art {
    aspect-ratio: 540 / 378;
    border-bottom: 1px solid var(--line);
    background: var(--fig-bg);
  }
  .home-track__art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .home-track__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 24px 26px 26px;
  }
  .home-track__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .home-track h3 {
    font-size: 30px;
  }
  .home-track p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.45;
  }
  /* The count and the button each stay on one line; if a card is too narrow for both, the button moves under, still
     at the right, level with the other cards' buttons. */
  .home-track__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 12px;
    margin-top: auto;
    padding-top: 14px;
  }
  .home-track__count {
    color: var(--muted);
    font: 500 13px/1.2 var(--mono);
    white-space: nowrap;
  }
  .home-track__go {
    margin-left: auto;
    white-space: nowrap;
  }

  /* ---------- See a lesson from the inside: a two-page blueprint sheet ---------- */
  .sheet {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 1080px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .sheet__page {
    padding: 34px 38px 36px;
  }
  .sheet__page--fig {
    display: flex;
    flex-direction: column;
    border-left: 1px dashed var(--line-strong);
    background: var(--card-2);
  }
  .sheet__label {
    margin-bottom: 18px;
  }
  .sheet h3 {
    margin: 6px 0 10px;
    font-size: 34px;
  }
  .sheet__hook {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
  }
  .sheet__hook :global(b) {
    color: var(--ink-strong);
  }
  .ex {
    margin-top: 22px;
    overflow: hidden;
    border-radius: var(--r-tile);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ex__head {
    padding: 14px 18px 12px;
    border-bottom: 1px solid var(--line);
  }
  .sheet__steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sheet__steps li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: baseline;
    gap: 10px;
    padding: 11px 18px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .sheet__steps li:first-child {
    border-top: 0;
  }
  .sheet__steps .n {
    color: var(--muted);
    font: 700 13px/1 var(--mono);
  }
  .sheet__steps .t {
    display: block;
    color: var(--ink-strong);
    font-size: 14.5px;
  }
  .sheet__steps .s {
    display: block;
    color: var(--muted);
  }
  .sheet__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .sheet__fig {
    display: grid;
    flex: 1;
    place-items: center;
    padding: 10px 6px;
    border-radius: var(--r-tile);
    background: var(--fig-bg);
  }
  .sheet__fig :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .sheet__more {
    margin: 28px 0 0;
    text-align: center;
  }

  /* ---------- Watch, learn, then practice: three cards, the art swapping sides ---------- */
  .feats {
    display: grid;
    gap: 26px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .feat {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    min-height: 360px;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .feat:nth-child(even) {
    grid-template-columns: 1fr 1.05fr;
  }
  .feat:nth-child(even) .feat__art {
    order: 2;
  }
  .feat__art {
    display: grid;
    place-items: center;
    padding: 18px 26px;
    background: var(--fig-bg);
  }
  .feat__art :global(svg) {
    display: block;
    width: 100%;
    max-width: 470px;
    height: auto;
  }
  .feat__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 44px 54px;
  }
  .feat__copy h3 {
    font-size: 40px;
  }
  .feat__copy p {
    max-width: 400px;
    margin: 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.5;
  }
  .feat__copy .btn {
    align-self: flex-start;
    margin-top: 6px;
  }

  /* ---------- Nothing to sign up for ---------- */
  .free {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 900px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .free__l {
    padding: 40px 44px;
  }
  .free__l h2 {
    margin-bottom: 14px;
    font-size: 36px;
  }
  .free__l p {
    margin: 0;
    color: var(--muted);
  }
  .free__r {
    padding: 40px 44px;
    border-left: 1px solid var(--line);
    background: var(--card-2);
  }
  .ticks {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ticks li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 16.5px;
  }
  .ticks li::before {
    content: '✓';
    color: var(--allowed-text);
    font-weight: 700;
  }

  /* ---------- Questions ---------- */
  .faq {
    max-width: 760px;
    margin: 0 auto;
  }
  .faq details {
    border-top: 1px solid var(--line);
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    color: var(--ink-strong);
    font-size: 19px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    color: var(--muted);
    font-size: 24px;
    font-weight: 400;
    line-height: 1;
    transition: transform 200ms var(--ease-out);
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .faq details p {
    max-width: 640px;
    margin: 0;
    padding: 0 4px 22px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
  }

  /* ---------- Narrow screens: not designed yet (task 8), only kept from breaking ---------- */
  @media (max-width: 960px) {
    .hero-art {
      display: none;
    }
    .home-tracks {
      grid-template-columns: 1fr;
    }
    .sheet,
    .feat,
    .feat:nth-child(even),
    .free {
      grid-template-columns: 1fr;
    }
    .feat:nth-child(even) .feat__art {
      order: 0;
    }
    .sheet__page--fig,
    .free__r {
      border-left: 0;
      border-top: 1px dashed var(--line-strong);
    }
  }
  @media (max-width: 720px) {
    .hero h1 {
      font-size: 48px;
    }
    .hero-actions {
      flex-direction: column;
      gap: 18px;
    }
    .band {
      padding: 72px 0;
    }
    .band--after,
    .band--faq {
      padding-top: 0;
    }
    .section-head h2 {
      font-size: 34px;
    }
    .sheet__page,
    .feat__copy,
    .free__l,
    .free__r {
      padding: 26px 22px;
    }
    .feat__copy h3 {
      font-size: 32px;
    }
  }
</style>
