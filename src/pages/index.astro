---
// Home (docs/direction.md §9). The page is a small lesson: under the headline a visitor can step through lesson 1,
// how a web page arrives over HTTP, read its Learn part and answer its first question, all without a script. Then
// come the tracks to begin with, where the facts come from, and the way into lesson 1.
// Every lesson word and every number is worked out from the content when the page is built (src/lib/home.ts).
// Nothing reads progress: a returning visitor sees the same page.
// The look is the Card stack (prototypes/d17-home-card-stack.md): cards with a hard edge on Patch's ground. It is scoped to this
// page, so the header, the footer and every other page keep Patch.
import { coverStill, type CoverId } from '../art/figures/covers';
import { pageFigure } from '../art/figures/pages';
import { cropViewBox } from '../art/ids';
import { factCheckSentence } from '../lib/about';
import { lessonCheckCounts } from '../lib/checked';
import { PARTS, demoCss, foldSources, homeDemo, homeStops } from '../lib/home';
import { startLesson } from '../lib/start';
import Rich from '../lesson/Rich';
import Stamp from '../components/Stamp';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../art/scenes/net-map.css';
import '../components/site.css';
import '../styles/card-stack.css';

const start = startLesson();
const demo = homeDemo();
const stops = homeStops();
const checks = lessonCheckCounts();
const factCheck = factCheckSentence(checks.checked, checks.total);

const PART_WORDS = { watch: 'Watch', learn: 'Learn', practice: 'Practice' } as const;
const last = demo.steps.length;
// Learn's foot (prototypes/d5-home-sources.md): the stamp, the first three sources, and the rest behind a <details>.
const { shown, folded } = foldSources(demo.learn.sources);
const List = demo.learn.numbered ? 'ol' : 'ul';

// A cover, cropped close to its plate. Each copy on the page tags its own ids.
const coverArt = (id: CoverId): string => cropViewBox(coverStill(id, `home-${id}`), '30 20 540 378');

// The demo's states, as CSS (src/lib/home.ts): which part, step and answer shows, and what each lights.
const css = demoCss(demo);

// The phone's key: the drawing's own callouts, in two bands. An address breaks only at its " · ".
const addrParts = (text: string): string[] => text.split(/(?<= ·) /);
---

<BaseLayout
  title="TechConcepts"
  description="Short visual lessons on how technology works. Watch a real exchange play one step at a time, read what happened in plain words, then try a few questions. Free, with no account."
>
  <section class="open wrap" aria-labelledby="home-title">
    <h1 id="home-title">See how technology really works.</h1>
    <div class="open__side">
      <p class="open__say">Short lessons you watch first. Each one plays a real exchange a step at a time, then says what happened in plain words.</p>
      <div class="open__acts">
        <a class="btn btn--primary" href={start.url}>Start with lesson 1: {start.title}</a>
        <a class="btn" href="/tracks">See the tracks</a>
      </div>
      <p class="open__facts">Free. No account. Your progress stays in this browser.</p>
    </div>
  </section>

  <section class="try wrap" id="try" aria-labelledby="try-title">
    <header class="try__head">
      <h2 id="try-title">Try one, right here</h2>
      <p>
        A browser asks a web server for a page. This is lesson {demo.lesson.number} of {demo.lesson.track}, <a href={demo.lesson.url}>{demo.lesson.title}</a>.
      </p>
    </header>

    <div class="demo">
      <style is:inline set:html={css}></style>
      {PARTS.map((part, i) => <input class="demo__in demo__in--part" type="radio" name="demo-part" id={`demo-${part}`} checked={i === 0} aria-label={`${PART_WORDS[part]} part`} />)}
      {
        demo.steps.map((step) => (
          <input class="demo__in demo__in--step" type="radio" name="demo-step" id={`demo-s${step.n}`} checked={step.n === 1} aria-label={`Watch, step ${step.n} of ${last}: ${step.title}`} />
        ))
      }
      {demo.practice.options.map((option, i) => <input class="demo__in demo__in--answer" type="radio" name="demo-answer" id={`demo-a${i + 1}`} aria-label={`Answer: ${option.text}`} />)}

      <div class="demo__ui">
        <div class="demo__parts" aria-hidden="true">
          {PARTS.map((part) => <label for={`demo-${part}`}>{PART_WORDS[part]}</label>)}
        </div>
        <p class="demo__hint demo__hint--part" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd><span>Arrow keys switch between Watch, Learn and Practice.</span></p>

        <figure class="demo__scene">
          <div class="demo__key demo__key--above" aria-hidden="true">
            {
              demo.key.above.map((call) => (
                <p class={call.end ? 'demo__call demo__call--end' : 'demo__call'}>
                  <b>{call.name}</b>
                  {call.lines.map((line) =>
                    line.kind === 'addr' ? (
                      <span class="demo__addr">
                        {addrParts(line.text).map((piece, i) => (i === 0 ? <span>{piece}</span> : <Fragment>{' '}<span>{piece}</span></Fragment>))}
                      </span>
                    ) : line.kind === 'state' ? (
                      <i>{line.text}</i>
                    ) : (
                      <span>{line.text}</span>
                    ),
                  )}
                </p>
              ))
            }
          </div>
          <div class="demo__crop"><Fragment set:html={demo.scene} /></div>
          <div class="demo__key demo__key--below" aria-hidden="true">
            {
              demo.key.below.map((call) => (
                <p class={call.end ? 'demo__call demo__call--end' : 'demo__call'}>
                  <b>{call.name}</b>
                  {call.lines.map((line) =>
                    line.kind === 'addr' ? (
                      <span class="demo__addr">
                        {addrParts(line.text).map((piece, i) => (i === 0 ? <span>{piece}</span> : <Fragment>{' '}<span>{piece}</span></Fragment>))}
                      </span>
                    ) : line.kind === 'state' ? (
                      <i>{line.text}</i>
                    ) : (
                      <span>{line.text}</span>
                    ),
                  )}
                </p>
              ))
            }
          </div>
        </figure>

        <div class="demo__pane demo__pane--watch">
          <ol class="demo__rows" aria-hidden="true" style={`--steps:${last}`}>
            {
              demo.steps.map((step) => (
                <li>
                  <label class="demo__row" for={`demo-s${step.n}`}>
                    <span class="demo__n">{step.n}</span>
                    <span class="demo__t">
                      <b>{step.title}</b>
                      <small>{step.sub}</small>
                    </span>
                  </label>
                </li>
              ))
            }
          </ol>
          <p class="demo__hint demo__hint--step" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd><span>Arrow keys move between the steps.</span></p>
          <div class="demo__says" aria-live="polite">
            {
              demo.steps.map((step) => (
                <div class={`demo__say demo__say--${step.n}`}>
                  <p>
                    <Rich text={step.narrative} />
                  </p>
                  {step.messages.length > 0 && (
                    <ul class="demo__msgs">
                      {step.messages.map((m) => (
                        <li data-kind={m.kind}>
                          <span>
                            {m.from} to {m.to}
                          </span>
                          <b>{m.tag}</b>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))
            }
          </div>
          <div class="demo__nexts" aria-hidden="true">
            {
              demo.steps.map((step) =>
                step.n < last ? (
                  <label class={`btn btn--primary demo__next demo__next--${step.n}`} for={`demo-s${step.n + 1}`}>
                    Next step
                  </label>
                ) : (
                  <label class={`btn btn--primary demo__next demo__next--${step.n}`} for="demo-learn">
                    Go to Learn
                  </label>
                ),
              )
            }
          </div>
        </div>

        <div class="demo__pane demo__pane--learn">
          <p class="demo__lead"><Rich text={demo.learn.lead} /></p>
          <dl class="demo__terms">
            {
              demo.learn.terms.map((term) => (
                <div>
                  <dt>{term.idea}</dt>
                  <dd>{term.name}</dd>
                </div>
              ))
            }
          </dl>
          <p class="demo__sealed">
            <b>And {demo.sealed.title}?</b>
            <Rich text={demo.sealed.lead} />
            <a href={demo.sealed.url}>
              Lesson {demo.sealed.number}: {demo.sealed.title}
            </a>
          </p>
          <div class="demo__src">
            <p class="demo__stamp"><Stamp stamp={demo.learn.stamp} /></p>
            {
              shown.length > 0 && (
                <List class="demo__list" role="list" aria-label="Sources">
                  {shown.map((source, i) => (
                    <li>
                      {demo.learn.numbered && <span class="demo__num">{i + 1}</span>}
                      <a href={source.url} title={source.label}>{source.name}</a>
                    </li>
                  ))}
                </List>
              )
            }
            {
              folded.length > 0 && (
                <details class="demo__more">
                  <summary>
                    <span class="demo__closed">Show the other {folded.length}</span>
                    <span class="demo__open">Hide the other {folded.length}</span>
                  </summary>
                  <List class="demo__list" role="list" start={demo.learn.numbered ? shown.length + 1 : undefined} aria-label={`Sources ${shown.length + 1} to ${demo.learn.sources.length}`}>
                    {folded.map((source, i) => (
                      <li>
                        {demo.learn.numbered && <span class="demo__num">{shown.length + i + 1}</span>}
                        <a href={source.url} title={source.label}>{source.name}</a>
                      </li>
                    ))}
                  </List>
                </details>
              )
            }
          </div>
          <div class="demo__nexts" aria-hidden="true">
            <label class="btn btn--primary demo__next demo__next--on" for="demo-practice">Go to Practice</label>
          </div>
        </div>

        <div class="demo__pane demo__pane--practice">
          <p class="demo__lead">{demo.practice.prompt}</p>
          <div class="demo__picks" aria-hidden="true">
            {
              demo.practice.options.map((option, i) => (
                <label class="demo__pick" for={`demo-a${i + 1}`}>
                  {option.text}
                </label>
              ))
            }
          </div>
          <p class="demo__hint demo__hint--answer" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd><span>Arrow keys choose an answer.</span></p>
          <div aria-live="polite">
            {
              demo.practice.options.map((option, i) => (
                <p class={`demo__why demo__why--${i + 1}`} data-right={option.right ? '' : undefined}>
                  <Rich text={option.feedback} />
                </p>
              ))
            }
          </div>
          <p class="demo__after">
            Nothing is scored. <a href={demo.lesson.url}>Open the whole lesson</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="order" aria-labelledby="order-title">
    <div class="wrap">
      <h2 id="order-title">Get started with the basics</h2>
      <ol class="cable">
        {
          stops.map((stop) => (
            <li class="leg">
              <div class="leg__art" aria-hidden="true">
                <Fragment set:html={coverArt(stop.cover)} />
              </div>
              <p class="leg__order">{stop.order}</p>
              <h3>
                <a href={stop.href}>{stop.title}</a>
              </h3>
              <p class="leg__blurb">{stop.blurb}</p>
              <p class="leg__count">
                <span class="leg__run" aria-hidden="true">
                  {Array.from({ length: stop.lessons.planned }, (_, i) => (
                    <i data-ready={i < stop.lessons.ready ? '' : undefined} />
                  ))}
                </span>
                {stop.count}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="facts" id="sources" aria-labelledby="facts-title">
    <div class="wrap facts__grid">
      <div class="facts__art" aria-hidden="true">
        <Fragment set:html={pageFigure('sources')} />
      </div>
      <div>
        <h2 id="facts-title">Where the facts come from</h2>
        <p>Each lesson lists the standards it draws on under Sources at the end of Learn. {factCheck}</p>
        <p><a href="/about#facts">How a lesson is made and checked</a></p>
      </div>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="wrap close__grid">
      <div>
        <h2 id="close-title">Lift the lid</h2>
        <p>Lesson 1 is {start.title}: what happens when you ask for a web page. You can stop anywhere and pick it up later.</p>
        <a class="btn btn--primary" href={start.url}>Start with lesson 1: {start.title}</a>
      </div>
      <div class="close__art" aria-hidden="true">
        <Fragment set:html={pageFigure('inside')} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
  /* The 68px sticky header must not hide what has keyboard focus: the root keeps 80px above anything scrolled into view
     and 12px below it (the footer's rings), and while the header's menu is open (below 960px; from there up the menu is not
     drawn) its height, 391px on Home at 320 to 959 wide, plus 12px. If the menu's links change, this number changes with them.
     Every scroll margin below is what a landing wanted less the 80px, so each lands where it always has. */
  :global(html) {
    scroll-padding-top: 80px;
    scroll-padding-bottom: 12px;
  }
  @media (max-width: 959px) {
    :global(html:has(#menu-panel:not([hidden]))) {
      scroll-padding-top: 403px;
    }
  }
  :global(main) {
    --gap: clamp(56px, 7vw, 96px);
  }
  h2 {
    margin: 0;
    font-size: clamp(28px, 2.6vw, 34px);
    line-height: 1.1;
    letter-spacing: 0;
  }
  section[id] {
    /* A link lands 88px under the window's top: the root's 80px padding and these 8px. */
    scroll-margin-top: 8px;
  }
  /* Links are ink, underlined; blue means a request and nothing else. */
  a:not(.btn) {
    text-decoration-thickness: 1.5px;
  }
  a:not(.btn):focus-visible {
    border-radius: 3px;
  }

  /* ---------- The opening: the line on the desk, set large, and what to do about it ---------- */
  .open {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 28px clamp(24px, 4vw, 64px);
    align-items: end;
    padding-top: clamp(40px, 5.6vw, 80px);
    padding-bottom: clamp(44px, 5.2vw, 76px);
  }
  .open h1 {
    margin: 0;
    font-size: clamp(50px, 7.4vw, 104px);
    line-height: 0.94;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .open__say {
    margin: 0;
    max-width: 27em;
    color: var(--ink-strong);
    font-size: 20px;
    line-height: 1.5;
  }
  .open__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
  }
  .open__facts {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  /* ---------- The demo: a stack of three cards, Watch, Learn and Practice, switched by radio buttons alone ---------- */
  .try {
    padding-bottom: 0;
  }
  .try__head {
    padding: 0 0 18px;
  }
  .try__head p {
    margin: 6px 0 0;
    color: var(--ink);
    font-size: 17px;
  }
  /* The demo is the grid: the tabs' row, the card's top edge, the part's rows, the card's foot edge. The card itself is
     .demo::before, a grid item across all of them; the card beneath it is its box-shadow and the one beneath that
     (dithered) is .demo::after. */
  .demo {
    --tab: 50px;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(300px, 1fr);
    grid-template-rows: var(--tab) 2px auto auto auto auto 1fr 2px;
    grid-template-areas:
      '.     parts'
      'top   top'
      'scene hint'
      'scene rows'
      'scene keys'
      'scene says'
      'scene nexts'
      'foot  foot';
    /* The longest part's room: D16's 503, the tabs' 50 and the two edges. */
    min-height: 555px;
    padding: 0 2px;
    margin-right: calc(2 * var(--cs-stack));
    overflow: visible;
  }
  .demo::before {
    content: '';
    grid-row: top-start / foot-end;
    grid-column: 1 / -1;
    margin: 0 -2px;
    border: 2px solid var(--cs-edge);
    border-radius: var(--cs-r);
    background: var(--cs-card);
    /* the card beneath: its right and bottom edge */
    box-shadow:
      var(--cs-stack) var(--cs-stack) 0 -2px var(--cs-card),
      var(--cs-stack) var(--cs-stack) 0 0 var(--cs-edge);
  }
  .demo::after {
    content: '';
    position: absolute;
    z-index: -1;
    grid-row: top-start / foot-end;
    grid-column: 1 / -1;
    inset: calc(2 * var(--cs-stack)) calc(-2 * var(--cs-stack) - 2px) calc(-2 * var(--cs-stack)) calc(2 * var(--cs-stack));
    border: 2px solid var(--cs-edge);
    border-radius: var(--cs-r);
    background: var(--cs-dither);
  }
  /* The radio buttons are out of sight, and still reached by Tab and the arrow keys. Each sits in the grid area where its
     group shows its result, so focusing it (a tap on a label does) scrolls nowhere when that place is on screen, and
     only as far as that place when it is not. Chrome scrolls a focused element only when its own box lies outside the
     scroll port (the window less the root's padding), margins not counted; so each radio's box is 81px tall, and with the
     -10px margin its 80px of padding and 70px (the header's height, and no more) put the landing where it always was. The
     bottom margins are what they were (360, 80 and 324px) less the 80px of padding above and the 12px below. */
  .demo__in {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 81px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    scroll-margin-top: -10px;
  }
  /* The tabs, the figure and the top of the part; */
  .demo__in--part {
    grid-area: parts;
    scroll-margin-bottom: 268px;
  }
  /* the top of the narration, clear of the phone's Next bar; */
  .demo__in--step {
    grid-area: says;
    scroll-margin-bottom: -12px;
  }
  /* the question, its three answers and the hint below them. */
  .demo__in--answer {
    grid-area: rows;
    scroll-margin-bottom: 232px;
  }
  .demo__ui {
    display: contents;
  }
  /* Index tabs, standing on the card's top edge. */
  .demo__parts {
    grid-area: parts;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    height: calc(var(--tab) + 2px);
    margin: 0 0 -2px -2px;
  }
  .demo__parts label {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 46px;
    padding: 0 22px;
    border: 2px solid var(--cs-edge);
    border-radius: var(--cs-r-in) var(--cs-r-in) 0 0;
    background: var(--cs-quiet);
    color: var(--ink);
    font: 600 17px/1 var(--display);
    letter-spacing: 0.01em;
    cursor: pointer;
  }
  .demo__parts label + label {
    margin-left: -2px;
  }
  .demo__parts label::before {
    content: '';
    display: none;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--cs-here);
    box-shadow: 0 0 0 1.5px var(--cs-edge);
  }
  /* The key hints: a strip of label tape by each group while that group has keyboard focus. */
  .demo__hint {
    display: none;
    width: fit-content;
    padding: 5px 10px 5px 8px;
    border: 1px solid var(--cs-hair);
    border-radius: 6px;
    background: var(--cs-quiet);
    color: var(--ink-strong);
    font: 600 15px/1.25 var(--display);
    letter-spacing: 0.01em;
  }
  .demo__hint--part {
    grid-area: hint;
    margin: 12px 18px 0;
  }
  .demo__hint--step {
    grid-area: keys;
    margin: 12px 18px 0;
  }
  .demo__hint--answer {
    margin: 12px 0 0;
  }
  .demo__hint kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    margin-right: 2px;
    padding: 0 3px;
    border: 1.5px solid var(--cs-edge);
    border-bottom-width: 3px;
    border-radius: 4px;
    background: var(--cs-card);
    font: 700 12px/1 var(--mono);
    vertical-align: 1px;
  }
  .demo__hint kbd + kbd {
    margin-left: 1px;
  }
  .demo__hint span {
    margin-left: 6px;
  }
  .demo__in--part:focus-visible ~ .demo__ui .demo__hint--part,
  .demo__in--step:focus-visible ~ .demo__ui .demo__hint--step,
  .demo__in--answer:focus-visible ~ .demo__ui .demo__hint--answer {
    display: block;
  }
  /* The scene: the figure on the card's own paper, a hard rule between it and the words. 6px at the sides keeps the
     drawing 720px wide at 1440, so its callout names stay 12px. */
  .demo__scene {
    grid-area: scene;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 12px 6px;
    border-right: 2px solid var(--cs-edge);
    border-radius: var(--cs-r-in) 0 0 var(--cs-r-in);
    background: var(--cs-card);
  }
  .demo__scene :global(svg) {
    width: 100%;
    max-height: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo__scene :global(*) {
      transition: none !important;
    }
  }
  /* The phone's key, its crop box and its leaders: off above 860px, where the drawing's own callouts show. */
  .demo__key {
    display: none;
  }
  .demo__crop {
    width: 100%;
  }
  :global(.nm .home-leads) {
    display: none;
  }
  :global(.nm .home-leads path) {
    fill: none;
    stroke: var(--cs-hair);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  :global(.nm .home-leads circle) {
    fill: var(--muted);
  }
  .demo__pane {
    display: none;
    min-height: 0;
  }
  .demo__pane--learn,
  .demo__pane--practice {
    grid-column: 2;
    grid-row: rows-start / nexts-end;
    padding: 20px 20px 22px;
  }
  /* The steps. */
  .demo__rows {
    grid-area: rows;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 16px 16px 0;
    list-style: none;
  }
  .demo__row {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 12px;
    align-items: center;
    padding: 6px 10px;
    border: 2px solid transparent;
    border-radius: var(--cs-r-in);
    cursor: pointer;
  }
  .demo__n {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 2px solid var(--cs-edge);
    border-radius: 6px;
    background: var(--cs-card);
    color: var(--ink-strong);
    font: 700 14px/1 var(--mono);
  }
  /* A step behind you: a tick, drawn, in the done colour. The number stays in the markup. */
  .demo__n::after {
    content: '';
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 13px;
    height: 7px;
