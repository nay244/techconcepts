---
import { CERT_TAGS, type CertTag } from '../content/certs';
import { getEntries, trackTotals, type AvailableSummary } from '../content/registry';
import { comingSoonTracks, tracks } from '../content/tracks';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContinueCard from '../components/ContinueCard';
import TrackProgress from '../components/TrackProgress';
import '../components/site.css';

const track = tracks[0]!;
const entries = getEntries(track.id);
const available = entries.filter((e): e is AvailableSummary => e.available);
const { planned, minutes } = trackTotals(entries);
// Lesson 1 may not be written yet: start at the first one that is.
const first = available[0]!;

const present = new Set(available.flatMap((e) => e.certTags));
const certTags = (Object.keys(CERT_TAGS) as CertTag[]).filter((tag) => present.has(tag));

const level = track.level.charAt(0).toUpperCase() + track.level.slice(1);

const steps = [
  { name: 'Watch', line: 'Follow each step as devices send messages to one another, with a plain-English explanation beside it.' },
  { name: 'Try', line: 'Change something yourself, like an address or a rule, and see what happens next.' },
  { name: 'Check', line: 'Answer a few questions to see what stuck. They are for you, so nothing is scored or saved.' },
];
---

<BaseLayout title="TechConcepts" description="Short, visual lessons that show how technology works, starting with networking. Watch it happen, try it yourself, and check what you learned.">
  <div class="container home">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">See how technology works, one short lesson at a time.</h1>
      <p class="hero__lede">Watch a network do its job, try changing it yourself, then check what stuck. Each lesson takes 15 minutes or less, and there is nothing to sign up for.</p>
      <div class="hero__actions">
        <ContinueCard client:load entries={available} planned={planned} />
        <a class="btn btn--primary hero__start" href={first.url}>Start with {track.title}</a>
      </div>
    </section>

    <section aria-labelledby="tracks-title" class="home__section">
      <h2 id="tracks-title">Tracks</h2>
      <ul class="cards" role="list">
        <li class="card">
          <h3 class="card__title"><a href={`/${track.id}`}>{track.title}</a></h3>
          <p>{track.description}</p>
          <ul class="card__stats" role="list">
            <li>{available.length} of {planned} lessons ready</li>
            <li>{minutes} min in total</li>
            <li>{level}</li>
          </ul>
          <TrackProgress client:load entries={entries} planned={planned} />
        </li>
        {
          comingSoonTracks.map((t) => (
            <li class="card card--soon">
              <h3 class="card__title">{t.title}</h3>
              <p>{t.blurb}</p>
              <p class="card__soon">Coming soon</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="prep-title" class="home__section">
      <h2 id="prep-title">Preparing for&hellip;</h2>
      <p class="home__note">Pick a certification or role to see the lessons that help.</p>
      <ul class="chips" role="list">
        {
          certTags.map((tag) => (
            <li>
              <a class="chip" href={`/${track.id}?for=${tag}`}>{CERT_TAGS[tag]}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="how-title" class="home__section">
      <h2 id="how-title">How a lesson works</h2>
      <ol class="how" role="list">
        {
          steps.map((s, i) => (
            <li class="how__step">
              <span class="how__num" aria-hidden="true">{i + 1}</span>
              <h3 class="how__name">{s.name}</h3>
              <p>{s.line}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .home {
    padding-block: var(--space-7) var(--space-4);
  }
  .home__section {
    margin-top: var(--space-8);
  }
  .home__note {
    max-width: var(--measure);
    color: var(--ink-muted);
  }
  .hero h1 {
    max-width: 22ch;
    margin-bottom: var(--space-4);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.25rem);
    letter-spacing: -0.02em;
  }
  .hero__lede {
    max-width: var(--measure);
    font-size: var(--text-lg);
  }
  /* Room for the Continue card, so nothing moves when it fills in after load. */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-3);
    min-height: 9.5rem;
    margin-top: var(--space-5);
    align-content: flex-start;
  }
  @media (min-width: 40rem) {
    .hero__actions {
      min-height: 4.75rem;
    }
  }
  /* With a Continue card present, the start link steps back to a secondary button. */
  .hero__actions:has(.continue-card) .hero__start {
    border-color: var(--line-strong);
    background: var(--panel-raised);
    color: var(--ink-strong);
    align-self: center;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .card:first-child {
    border-color: var(--line-strong);
    grid-column: 1 / -1;
    max-width: 48rem;
  }
  .card__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }
  .card__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .card--soon {
    border-style: dashed;
    background: transparent;
    color: var(--ink-muted);
  }
  .card--soon .card__title {
    color: var(--ink-muted);
  }
  .card__soon {
    margin: auto 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .how {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .how__step {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .how__num {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .how__name {
    margin-bottom: var(--space-2);
  }
  .how__step p {
    margin: 0;
  }
</style>
