---
// A track's page (prototypes/d20-track-page-card-stack.md, layout 1, Route) in the Card stack look: the crumb, the
// track's name and who it is for, then the strip and the lesson up next, with the route of parts and a card of words
// for each lesson beside them (above them on a phone). The page scrolls as every other page does; the side column
// stays in view where the screen can hold it. The strip, the up-next card and the route are islands that read this
// browser's progress; until it has loaded, and without JavaScript, they show a first visit, every lesson listed. No
// lesson figure is drawn here (the lessons draw their own). The look's shared parts are src/styles/card-stack.css; the
// rules below are this page's own and scoped to it.
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getEntries, getLesson, type AvailableSummary } from '../../content/registry';
import type { Lesson } from '../../content/schema';
import { internetTrack, networkingTrack, tracks } from '../../content/tracks';
import { knownFrom } from '../../lib/entries';
import { lessonStamp } from '../../lib/checked';
import { islandEntries, routeParts, trackParts } from '../../lib/track';
import { stripLongest } from '../../lib/tracks-page';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrackRoute from '../../components/hub/TrackRoute';
import TrackSide from '../../components/hub/TrackSide';
import '../../components/site.css';
import '../../components/hub/hub.css';
import '../../styles/card-stack.css';

export const getStaticPaths = (() =>
  tracks.map((track) => ({
    params: { track: track.id },
    props: { track },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { track } = Astro.props;

// After the last stop, one line pointing to the other track: How the Internet Works is the gentler start, Networking
// Concepts goes deeper. A new track needs its line here before it can be built.
const CROSS_LINKS: Record<string, { before: string; to: { id: string; title: string }; after: string }> = {
  [internetTrack.id]: { before: 'Ready for more? ', to: networkingTrack, after: ' goes deeper.' },
  [networkingTrack.id]: { before: 'New to IT? ', to: internetTrack, after: ' is the gentler start.' },
};
const cross = CROSS_LINKS[track.id];
if (cross === undefined) throw new Error(`The ${track.id} track has no line pointing to another track.`);

const entries = getEntries(track.id);
const known = knownFrom(entries);
const someNotReady = entries.some((e) => !e.available);

function lessonOf(entry: AvailableSummary): Lesson {
  const lesson = getLesson(entry.slug);
  // An available entry is built from its lesson, so this cannot happen.
  if (lesson === undefined) throw new Error(`No lesson file for ${entry.key}.`);
  return lesson;
}

// The islands are sent only what they draw: the page's HTML carries their props.
const parts = routeParts(trackParts(track, entries, lessonOf, lessonStamp));
const slim = islandEntries(entries);
---

<BaseLayout title={track.title} current="tracks" description={track.description}>
  <div class="wrap tk" style={`--strip-longest: "${stripLongest(entries)}"`}>
    <div class="side">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/tracks">Tracks</a></li>
          <li><span class="sep" aria-hidden="true">/</span><span aria-current="page">{track.title}</span></li>
        </ol>
      </nav>
      <h1 class="disp">{track.title}</h1>
      <p class="lede">{track.description}</p>
      <TrackSide client:load entries={slim} known={known} />
    </div>

    <TrackRoute client:load parts={parts} entries={slim} known={known} />
    {/* One line: Astro drops the space at a line break before a link. */}
    <p class="route__end">
      {someNotReady && 'Lessons not ready yet stay on the route, so you can see what is coming. '}{cross.before}<a href={`/${cross.to.id}`}>{cross.to.title}</a>{cross.after}
    </p>
  </div>
</BaseLayout>

<style>
  /* The 68px sticky header must not hide what has keyboard focus: the root keeps 80px above anything scrolled into view
     (as /tracks does), and while the header's menu is open (below 960px; from there up the menu is not drawn) its
     height, 329px at 320 to 959 wide on this page, plus 12px. If the menu's links change, this number changes with them. */
  :global(html) {
    scroll-padding-top: 80px;
  }
  @media (max-width: 959px) {
    :global(html:has(#menu-panel:not([hidden]))) {
      scroll-padding-top: 341px;
    }
  }

  .tk {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: 8px;
  }
  .tk :global(a:not(.btn):focus-visible) {
    border-radius: 3px;
  }
  /* A focused link or button keeps its ring clear of the screen's edge and of the header. */
  .tk :is(.crumbs a, .route__end a),
  .tk :global(.upnext__btn) {
    scroll-margin-block: 12px;
  }

  /* The crumb back to Tracks. */
  .tk .crumbs {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.4;
  }
  .tk .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tk .crumbs li {
    display: flex;
    align-items: center;
  }
  .tk .crumbs a {
    display: inline-block;
    padding: 4px 0;
    color: var(--ink-strong);
    text-decoration: underline;
    text-decoration-color: var(--cs-hair);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }
  .tk .crumbs a:hover {
    text-decoration-color: currentColor;
  }
  .tk .crumbs .sep {
    margin: 0 8px;
  }
  .tk .crumbs [aria-current] {
    color: var(--ink);
  }

  /* The track's name and who it is for. No word is picked out in a colour. */
  .tk .side h1 {
    margin: 8px 0 0;
    color: var(--ink-strong);
    font-size: clamp(40px, 4.6vw, 60px);
    line-height: 0.98;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .tk .lede {
    margin: 14px 0 0;
    max-width: 36em;
    color: var(--ink);
    font-size: 16.5px;
    line-height: 1.5;
  }

  /* How far this browser has got: one square a lesson, as on Tracks. Hollow is not done, green is done, orange and
     taller is the lesson up next. Every row of squares is 14px tall in every state. */
  .tk :global(.strip) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 16px;
  }
  .tk :global(.strip__sq) {
    align-items: center;
    gap: 3px;
  }
  .tk :global(.strip__sq i) {
    width: 10px;
    height: 10px;
    margin-block: 2px;
  }
  .tk :global(.strip__sq i[data-state]) {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--cs-edge);
    opacity: 1;
  }
  .tk :global(.strip__sq i[data-state='done']) {
    background: var(--cs-done);
  }
  .tk :global(.strip__sq i[data-state='current']) {
    height: 14px;
    margin-block: 0;
    background: var(--cs-here);
  }
  /* A lesson that is not ready (none today) keeps Tracks' faint square: the island writes no data-state for it. */
  .tk :global(.strip__sq i:not([data-state])) {
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    opacity: 0.6;
  }
  /* The words keep the width of their longest form ("14 of 14 lessons done"), so the strip wraps at the same width
     whatever the count: a hidden copy of the longest form sets the box, as on Tracks. */
  .tk :global(.strip__w) {
    color: var(--muted);
    font: 400 15px/1.3 var(--sans);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tk :global(.strip__w)::after {
    content: var(--strip-longest);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }
  /* At 320 wide twenty squares would leave one alone on a second line. */
  @media (max-width: 359px) {
    .tk :global(.strip__sq) {
      gap: 2px;
    }
  }

  /* The lesson up next and its way in: one card, its index tab the kicker, one card beneath. The page's one filled
     button. */
  .tk :global(.upnext) {
    max-width: 480px;
    margin-top: 58px; /* 34px of it is the tab */
    padding: 18px 18px 20px;
  }
  .tk :global(.upnext__l) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
  }
  .tk :global(.upnext__n),
  .tk :global(.stop__node) {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 2px solid var(--cs-edge);
    border-radius: 6px;
    background: var(--cs-card);
    color: var(--ink-strong);
    font: 700 14px/1 var(--mono);
  }
  .tk :global(.upnext__n[data-state='here']),
  .tk :global(.stop--now .stop__node) {
    background: var(--cs-here);
    color: var(--cs-here-ink);
  }
  .tk :global(.upnext__n[data-state='done']),
  .tk :global(.stop--done .stop__node) {
    background: var(--cs-done);
    color: var(--cs-card);
  }
  .tk :global(.upnext__t) {
    min-width: 0;
    color: var(--ink-strong);
    font: 700 24px/1.15 var(--display);
  }
  /* Two lines are kept for the subtitle, so the card is as tall for every lesson (Tracks' E9). */
  .tk :global(.upnext__s) {
    min-height: 2.9em;
    margin: 6px 0 0 46px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.45;
  }
  .tk :global(.upnext__btn) {
    width: 100%;
    margin-top: 12px;
  }
  @media (max-width: 860px) {
    .tk :global(.upnext) {
      margin-top: 50px;
    }
  }

  /* The parts and their lessons. */
  .tk :global(.route) {
    margin-top: 40px;
  }
  .tk :global(.route-stage + .route-stage) {
    margin-top: 36px;
  }
  .tk :global(.route-stage h2) {
    display: inline-block;
    position: relative;
    margin: 0 12px 0 0;
    color: var(--ink-strong);
    font-size: 28px;
    line-height: 1.15;
  }
  .tk :global(.route-stage__count) {
    display: inline-block;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.3;
  }
  .tk :global(.route-stops) {
    display: grid;
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .tk :global(.stop) {
    position: relative;
  }

  /* The lesson's name is the one link, and it covers the whole stop. */
  .tk :global(.stop h3) {
    margin: 0;
    color: var(--ink-strong);
    font-size: 21px;
    line-height: 1.2;
  }
  .tk :global(.stop h3 a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--cs-hair);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
    scroll-margin: 24px 0 160px;
  }
  .tk :global(.stop h3 a::after) {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .tk :global(.stop:hover h3 a) {
    text-decoration-color: currentColor;
  }
  .tk :global(.stop h3 a:focus-visible) {
    outline: none;
  }
  .tk :global(.stop:has(h3 a:focus-visible)) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .tk :global(.stop__sub) {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.45;
  }

  /* A stop's status (with Watch, Learn, Practice once begun) at the left of its foot, the day it was checked at the
     right; where both do not fit on a line the stamp goes under. */
  .tk :global(.stop__info) {
    padding: 12px 14px;
  }
  .tk :global(.stop__foot) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 14px;
    margin-top: 10px;
  }
  .tk :global(.stop__state) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin: 0;
  }
  .tk :global(.stop__k) {
    color: var(--muted);
    font: 600 15px/1.3 var(--display);
    letter-spacing: 0.01em;
  }
  .tk :global(.stop__k.go) {
    color: var(--ink-strong);
  }
  .tk :global(.stop__k.done) {
    color: var(--cs-done-text);
  }
  /* The lesson to continue from: the chip is orange and the stop has the pale orange wash, as a step on show on Home. */
  .tk :global(.stop--now) {
    background-image: linear-gradient(var(--cs-here-wash), var(--cs-here-wash));
  }

  /* Where you are inside a lesson: three squares in the strip's own language, each with its name. */
  .tk :global(.wlp) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .tk :global(.wlp__p) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font: 400 13.5px/1.3 var(--sans);
  }
  .tk :global(.wlp__p i) {
    width: 14px;
    height: 8px;
    border-radius: 2px;
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--cs-edge);
  }
  .tk :global(.wlp__p.is-done i) {
    background: var(--cs-done);
  }
  .tk :global(.wlp__p.is-now) {
    color: var(--ink-strong);
    font-weight: 700;
  }
  .tk :global(.wlp__p.is-now i) {
    height: 12px;
    background: var(--cs-here);
  }

  /* A lesson that is not ready (no track has one today): dashed, no link. */
  .tk :global(.stop--soon) {
    border-style: dashed;
  }
  .tk :global(.stop--soon .stop__node) {
    border-style: dashed;
    color: var(--muted);
  }
  .tk :global(.stop--soon h3) {
    color: var(--muted);
  }

  /* The line on to the other track. */
  .tk .route__end {
    margin: 36px 0 0;
    color: var(--ink);
    font-size: 16.5px;
    line-height: 1.5;
  }
  .tk .route__end a {
    color: var(--ink-strong);
    text-decoration: underline;
    text-decoration-color: var(--cs-hair);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.16em;
  }
  .tk .route__end a:hover {
    text-decoration-color: currentColor;
  }

  /* ---------- Below 700px: no rail. The number sits in the card, beside the name and the subtitle. ---------- */
  @media (max-width: 860px) {
    /* Cards sit 14px in from the screen's edges, as on Tracks; words outside a card start at 32px. */
    .tk :global(.upnext) {
      margin-inline: -18px calc(-18px + var(--cs-stack));
    }
    .tk :global(.route-stage h2) {
      font-size: 24px;
    }
  }
  @media (max-width: 699px) {
    .tk :global(.stop) {
      margin-inline: -18px;
    }
    .tk :global(.stop__node) {
      position: absolute;
      left: 14px;
      top: 12px;
    }
    .tk :global(.stop h3),
    .tk :global(.stop__sub) {
      padding-left: 46px;
    }
    .tk :global(.stop h3) {
      padding-top: 3px;
    }
  }

  /* ---------- 700px and up: the rail. A line down the route, a filled square at each part, each lesson's number on
     it, tied to its card. Offsets are from a stop's padding box, 58px in (56 of padding and the card's 2px edge); the tie
     is 22px so that, with the chip 2px nearer the rail than drawn, it still runs from the chip to the card's edge. ---------- */
  @media (min-width: 700px) {
    .tk :global(.route) {
      position: relative;
      padding-left: 56px;
    }
    .tk :global(.route)::before {
      content: '';
      position: absolute;
      left: 16px;
      top: 12px;
      bottom: 24px;
      width: 2px;
      background: var(--cs-hair);
    }
    .tk :global(.route-stage h2)::before {
      content: '';
      position: absolute;
      left: -47px;
      top: 0.28em;
      width: 16px;
      height: 16px;
      border-radius: 3px;
      background: var(--cs-edge);
      box-shadow: 0 0 0 5px var(--ground);
    }
    .tk :global(.stop__node) {
      position: absolute;
      left: -58px;
      top: 50%;
      translate: 0 -50%;
      box-shadow: 0 0 0 4px var(--ground);
    }
    .tk :global(.stop)::before {
      content: '';
      position: absolute;
      left: -24px;
      top: 50%;
      width: 22px;
      height: 2px;
      margin-top: -1px;
      background: var(--cs-edge);
    }
    .tk :global(.stop__info) {
      padding: 13px 18px 14px;
    }
    .tk :global(.stop__foot) {
      margin-top: 8px;
    }
  }
  /* Where the card is 633px wide or more, it is two lines: the name over the subtitle at the left, the status over
     the stamp at the right. The widths are the ones at which the longest subtitle, a status with its three marks and
     the stamp all fit, so no card changes height when progress loads. */
  @media (min-width: 768px) and (max-width: 1023px), (min-width: 1200px) {
    .tk :global(.stop__info) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 24px;
      row-gap: 3px;
      align-items: center;
    }
    .tk :global(.stop h3) {
      grid-column: 1;
      grid-row: 1;
    }
    .tk :global(.stop__sub) {
      grid-column: 1;
      grid-row: 2;
      margin: 0;
    }
    .tk :global(.stop__foot) {
      display: contents;
    }
    .tk :global(.stop__state) {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
    }
    .tk :global(.stop .stamp) {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
    }
  }
  @media (min-width: 1024px) {
    .tk {
      display: grid;
      grid-template-columns: 300px minmax(0, 1fr);
      column-gap: 40px;
      align-items: start;
    }
    .tk .side {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .tk .side h1 {
      font-size: 44px;
    }
    .tk :global(.route) {
      grid-column: 2;
      grid-row: 1;
      margin-top: 0;
    }
    .tk .route__end {
      grid-column: 2;
      grid-row: 2;
      padding-left: 56px;
    }
  }
  @media (min-width: 1200px) {
    .tk {
      grid-template-columns: 360px minmax(0, 1fr);
      column-gap: clamp(40px, 5vw, 72px);
    }
    .tk .side h1 {
      font-size: 52px;
    }
  }
  /* The side column stays while the route scrolls, where the screen is tall enough to hold all of it. */
  @media (min-width: 1024px) and (min-height: 700px) {
    .tk .side {
      position: sticky;
      top: 92px;
    }
  }
  @media (min-width: 1200px) and (max-height: 820px) {
    .tk .side h1 {
      font-size: 44px;
    }
  }
</style>
