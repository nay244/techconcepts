---
// A track's page (spec §6.3, as the adopted insideout-study mockup's track page): a split page. On a large screen the
// window does not scroll: the side card on the left (the breadcrumb, the track's name, who it is for, its strip and
// the lesson up next) stays put, and the route on the right, the track's parts with a stop for each lesson, scrolls
// on its own, the site footer at its end. Below that size it is an ordinary page, the side card above the route.
// The strip, the up-next card and the route are islands that read this browser's progress; until it has loaded, and
// without JavaScript, they show a first visit, every lesson listed.
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getEntries, getLesson, type AvailableSummary } from '../../content/registry';
import type { Lesson } from '../../content/schema';
import { internetTrack, networkingTrack, tracks } from '../../content/tracks';
import { knownFrom } from '../../lib/entries';
import { lessonFigure } from '../../lib/figures';
import { trackParts } from '../../lib/track';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TrackRoute from '../../components/hub/TrackRoute';
import TrackSide from '../../components/hub/TrackSide';
import '../../components/site.css';
import '../../components/hub/hub.css';

export const getStaticPaths = (() =>
  tracks.map((track) => ({
    params: { track: track.id },
    props: { track },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { track } = Astro.props;

// After the last stop, one line pointing to the other track: How the Internet Works is the gentler start, Networking
// Concepts goes deeper. A new track needs its line here before it can be built.
const CROSS_LINKS: Record<string, { before: string; to: { id: string; title: string }; after: string }> = {
  [internetTrack.id]: { before: 'Ready for more? ', to: networkingTrack, after: ' goes deeper.' },
  [networkingTrack.id]: { before: 'New to IT? ', to: internetTrack, after: ' is the gentler start.' },
};
const cross = CROSS_LINKS[track.id];
if (cross === undefined) throw new Error(`The ${track.id} track has no line pointing to another track.`);

const entries = getEntries(track.id);
const known = knownFrom(entries);
const someNotReady = entries.some((e) => !e.available);

function lessonOf(entry: AvailableSummary): Lesson {
  const lesson = getLesson(entry.slug);
  // An available entry is built from its lesson, so this cannot happen.
  if (lesson === undefined) throw new Error(`No lesson file for ${entry.key}.`);
  return lesson;
}

const parts = trackParts(track, entries, lessonOf);
// Each ready lesson's figure goes to both islands as static HTML in a slot named after the lesson's number, so it is
// not repeated in their props: the route shows each one, the side card the one up next.
const figures = entries
  .filter((e): e is AvailableSummary => e.available)
  .map((entry) => ({ slot: `art${entry.number}`, svg: lessonFigure(track.id, entry) }));

// The title with its last word in the accent: 'Networking <em>Concepts</em>'.
const cut = track.title.lastIndexOf(' ');
const head = track.title.slice(0, cut + 1);
const last = track.title.slice(cut + 1);
---

<BaseLayout title={track.title} current="tracks" description={track.description} split footer={false}>
  <div class="side">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/tracks">Tracks</a></li>
        <li><span class="sep" aria-hidden="true">/</span><span aria-current="page">{track.title}</span></li>
      </ol>
    </nav>
    <h1 class="disp">{head}<em>{last}</em></h1>
    <p class="lede">{track.description}</p>
    <TrackSide client:load entries={entries} known={known}>
      {figures.map(({ slot, svg }) => <Fragment slot={slot} set:html={svg} />)}
    </TrackSide>
  </div>

  <div class="routebox">
    <div class="routebox__in">
      <TrackRoute client:load parts={parts} entries={entries} known={known}>
        {figures.map(({ slot, svg }) => <Fragment slot={slot} set:html={svg} />)}
      </TrackRoute>
      {/* One line: Astro drops the space at a line break before a link. */}
      <p class="route__end">
        {someNotReady && 'Lessons not ready yet stay on the route, so you can see what is coming. '}{cross.before}<a href={`/${cross.to.id}`}>{cross.to.title}</a>{cross.after}
      </p>
    </div>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  /* ---------- The side card: where you are in the track, and the lesson up next ---------- */
  .side {
    padding: 28px 32px 0;
  }
  .crumbs {
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .crumbs .sep {
    margin: 0 8px;
    opacity: 0.5;
  }
  .crumbs [aria-current] {
    color: var(--ink-strong);
  }
  .side h1 {
    color: var(--ink-strong);
    font-size: 64px;
  }
  .lede {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }
  /* The squares wrap under the words rather than squeezing into a column. */
  .side :global(.strip) {
    flex-wrap: wrap;
    row-gap: 8px;
    margin-top: 20px;
  }

  /* ---------- The route, then one line pointing to the other track ---------- */
  .routebox__in {
    padding: 36px 32px 0;
  }
  .route__end {
    margin: 36px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .route__end a {
    color: var(--ink-strong);
    font-weight: 600;
  }

  /* ---------- A large screen: the window is one screen, and only the route scrolls ---------- */
  /* BaseLayout's `split` locks the body to the window at this same size (global.css); main is the grid of the side
     card and the route. --edge keeps the content on the 1240px container and puts the route's scrollbar at the
     window's edge. */
  @media (min-width: 1024px) and (min-height: 600px) {
    :global(body.split > main) {
      --edge: max(32px, calc((100vw - 1240px) / 2));
      display: grid;
      grid-template-columns: calc(var(--edge) + 360px) 1fr;
      grid-template-rows: minmax(0, 1fr);
    }
    .side {
      min-height: 0;
      overflow-y: auto;
      padding: 28px 0 24px var(--edge);
    }
    .routebox {
      min-width: 0;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      padding: 28px var(--edge) 0 64px;
      /* A focus ring scrolled into view clears the fade. */
      scroll-padding-top: 28px;
      /* A short fade where the route slides under the header. */
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 22px);
      mask-image: linear-gradient(to bottom, transparent 0, #000 22px);
    }
    /* The space between the closing line and the footer; nothing below the footer. */
    .routebox__in {
      padding: 0 0 80px;
    }
  }

  /* ---------- Narrow screens: not designed yet (task 8), only kept from breaking ---------- */
  @media (max-width: 720px) {
    .routebox :global(.stop__tile) {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
    .routebox :global(.stop__art) {
      flex-basis: auto;
    }
  }
  @media (max-width: 560px) {
    .side,
    .routebox__in {
      padding-inline: 20px;
    }
    .side h1 {
      font-size: 44px;
    }
  }
</style>
