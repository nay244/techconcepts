---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getEntries, getLesson, type AvailableSummary } from '../../content/registry';
import { tracks } from '../../content/tracks';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../components/site.css';

/** One page for every lesson that has been written, in every track. */
export const getStaticPaths = (() =>
  tracks.flatMap((track) =>
    getEntries(track.id)
      .filter((entry): entry is AvailableSummary => entry.available)
      .map((entry) => {
        const lesson = getLesson(track.id, entry.slug);
        // An available entry is built from its lesson, so this cannot happen.
        if (lesson === undefined) throw new Error(`No lesson file for ${entry.key}.`);
        return { params: { track: track.id, lesson: entry.slug }, props: { track, lesson } };
      }),
  )) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

// A plain page until the Watch, Learn, Practice console arrives.
const { track, lesson } = Astro.props;
---

<BaseLayout title={lesson.title} description={lesson.summary}>
  <div class="wrap lesson-placeholder">
    <h1>{lesson.title}</h1>
    <p>{lesson.subtitle}</p>
    <p><a href={`/${track.id}`}>Back to {track.title}</a></p>
  </div>
</BaseLayout>

<style is:global>
  .lesson-placeholder {
    padding-block: var(--space-8);
  }
</style>
