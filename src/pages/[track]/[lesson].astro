---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { lessonFigure } from '../../lib/figures';
import { drawFigure } from '../../art/scenes';
import { fillLabels } from '../../art/scenes/labels';
import { getEntries, getLesson, neighbors, type AvailableSummary } from '../../content/registry';
import { tracks } from '../../content/tracks';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonConsole from '../../lesson/LessonConsole';

/** One page for every lesson that has been written, in every track. */
export const getStaticPaths = (() =>
  tracks.flatMap((track) => {
    const entries = getEntries(track.id);
    return entries
      .filter((entry): entry is AvailableSummary => entry.available)
      .map((entry) => {
        const lesson = getLesson(entry.slug);
        // An available entry is built from its lesson, so this cannot happen.
        if (lesson === undefined) throw new Error(`No lesson file for ${entry.key}.`);
        return {
          params: { track: track.id, lesson: entry.slug },
          props: { track, entry, entries, lesson, next: neighbors(entries, entry.slug).next },
        };
      });
  })) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { track, entry, entries, lesson, next } = Astro.props;
// Drawn here, at build time: the island gets the SVG as static markup and its driver's data as a prop.
// The console opens on the first unit, so its words are written into the figure's label slots now (a figure without
// slots is unchanged).
const drawn = drawFigure(lesson.figure);
const data = drawn.data;
const svg = fillLabels(drawn.svg, lesson.units[0]!.scene.labels);
// The next lesson's own art for the Up next card at the end of Practice (null on a track's last ready lesson).
const nextFigure = next === null ? null : lessonFigure(track.id, next);
// The console has its own top bar and <main id="main">, so the layout adds no header, main or footer.
---

<BaseLayout title={lesson.title} description={lesson.summary} chrome={false} canonical={entry.canonical}>
  <LessonConsole
    client:load
    trackId={track.id}
    trackTitle={track.title}
    lesson={lesson}
    entry={entry}
    total={entries.length}
    next={next}
    nextFigure={nextFigure}
    entries={entries}
    figureData={data}
  >
    <Fragment slot="figure" set:html={svg} />
  </LessonConsole>
</BaseLayout>
