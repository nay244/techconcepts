---
// About (docs/direction.md §11). A plain opening with the site's three counts, then what it is, how a lesson works,
// where the facts come from, credits, and where progress is kept. The counts, the tracks still to come and the DHCP
// lesson's sources are worked out from the content. Only Reset progress runs as an island. The "On this page" list
// is plain links; a small module script marks the section being read.
import { pageFigure } from '../art/figures/pages';
import { spot } from '../art/figures/spots';
import { getLesson } from '../content/registry';
import type { Lesson } from '../content/schema';
import { comingSoonTracks, plannedTracks, tracks } from '../content/tracks';
import { comingTracksSentence, factCheckSentence, sourceRows } from '../lib/about';
import { lessonCheckCounts } from '../lib/checked';
import { analyticsToken } from '../lib/analytics';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResetProgress from '../components/ResetProgress';
import '../components/site.css';

// The first track, How the Internet Works, is the one "Who it's for" names: the beginner entry.
const track = tracks[0]!;

/** A ready lesson, by slug, whichever track lists it. */
function readyLesson(slug: string): Lesson {
  const lesson = getLesson(slug);
  if (lesson === undefined) throw new Error(`About needs the ${slug} lesson, and it is not ready.`);
  return lesson;
}

// ---------- Hero ----------
// The tracks with lessons, the one being written (CompTIA A+), and the ones further out.
const tracksPlanned = tracks.length + plannedTracks.length + comingSoonTracks.length;

// ---------- Body ----------
// The tracks with no lessons yet, the nearest first: CompTIA A+, then the ones further out.
const coming = comingTracksSentence([...plannedTracks, ...comingSoonTracks].map((t) => t.title));
const dhcp = readyLesson('dhcp');
const sources = sourceRows(dhcp.units.flatMap((u) => u.references));
// How many ready lessons have passed the fact-checker (src/lib/checked.ts); Home says the same sentence.
const checks = lessonCheckCounts();
// A lesson two tracks list is one lesson, so the ready count is the distinct count, not a sum over tracks.
const lessonsReady = checks.total;
const factCheck = factCheckSentence(checks.checked, checks.total);
---

<BaseLayout
  title="About"
  current="about"
  description="What TechConcepts is, how its lessons are made, who inspired it, and how it keeps your progress private."
>
  <section class="wrap a-open" aria-labelledby="about-title">
    <nav class="a-crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><span aria-current="page">About</span></li>
      </ol>
    </nav>
    <h1 id="about-title">Watch it happen, then learn its name.</h1>
    <div class="a-open__row">
      <p class="a-lede">
        TechConcepts is a free site of short, visual lessons on how technology works. You watch a real process play out one step at a time, then
        read what it was, in plain words.
      </p>
      <dl class="stats">
        <div><dt>tracks planned</dt><dd>{tracksPlanned}</dd></div>
        <div><dt>lessons ready</dt><dd>{lessonsReady}</dd></div>
        <div><dt>accounts needed</dt><dd>0</dd></div>
      </dl>
    </div>
  </section>

  <div class="wrap a-body">
    <nav class="a-toc" aria-label="On this page">
      <p class="toc-h">On this page</p>
      <ol>
        <li><a href="#what">What it is</a></li>
        <li><a href="#lessons">How a lesson works</a></li>
        <li><a href="#facts">Where the facts come from</a></li>
        <li><a href="#credits">Credits</a></li>
        <li><a href="#privacy">Your progress</a></li>
      </ol>
    </nav>

    <div>
      <section class="a-sec" id="what" aria-labelledby="what-h">
        <h2 id="what-h">What TechConcepts is</h2>
        <p>
          TechConcepts teaches how technology works by showing it. Each lesson plays a real process, such as a laptop asking the network for an
          address, one step at a time, and explains each step in plain words.
        </p>
        <p>
          The first track, {track.title}, is written for anyone starting out, including people studying for entry-level IT certifications. {coming}
        </p>
        <p>You don’t need an account, and you can open any lesson in any order.</p>
      </section>

      <section class="a-sec" id="lessons" aria-labelledby="lessons-h">
        <h2 id="lessons-h">How a lesson works</h2>
        <p>Every lesson has the same three parts, so you always know where you are.</p>
        <ol class="a-steps">
          <li class="card">
            <div class="art" set:html={spot('watch')} />
            <div class="body">
              <span class="n">1 Watch</span>
              <h3>See it happen</h3>
              <p>A scene plays the process step by step. Pause it, slow it down, or go back a step whenever you like.</p>
            </div>
          </li>
          <li class="card">
            <div class="art" set:html={spot('learn')} />
            <div class="body">
              <span class="n">2 Learn</span>
              <h3>Get the idea, then the name</h3>
              <p>Each idea starts with an everyday comparison, then gives you the real term. Exam detail waits under Go deeper, closed until you want it.</p>
            </div>
          </li>
          <li class="card">
            <div class="art" set:html={spot('practice')} />
            <div class="body">
              <span class="n">3 Practice</span>
              <h3>Check yourself</h3>
              <p>A few questions, just for you. Each answer says why it’s right or not. Nothing is scored or saved.</p>
            </div>
          </li>
        </ol>
        <div class="a-note">
          <svg class="t" viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
              d="M12 7v5l3.2 2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          <p>
            <b>Lessons are self-paced.</b> Take as long as you need. This browser remembers where you stopped, so you can pick up where you left off.
          </p>
        </div>
        <p>The example networks use addresses set aside for documentation and private use, so nothing in a lesson points at a real machine.</p>
      </section>

      <section class="a-sec" id="facts" aria-labelledby="facts-h">
        <h2 id="facts-h">Where the facts come from</h2>
        <div class="a-facts">
          <p>
            Each lesson lists the standards it draws on under Sources at the end of Learn. {factCheck}
          </p>
          <div class="a-facts__art" aria-hidden="true" set:html={pageFigure('sources')} />
        </div>
        <div class="card a-src">
          <h3>Sources in the {dhcp.title} lesson</h3>
          <ul>
            {
              sources.map((s) => (
                <li>
                  <span>{s.standard}</span>
                  <a href={s.url}>{s.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="a-sec" id="credits" aria-labelledby="credits-h">
        <h2 id="credits-h">Credits</h2>
        <p>
          Protocol Explorer and TryHackMe inspired TechConcepts: the first for the idea of watching a protocol work, the second for its friendly,
          guided way of teaching. They are inspiration only. TechConcepts is not affiliated with, endorsed by, or built from either of them.
        </p>
        <dl class="a-credits">
          <dt>Figures</dt>
          <dd>Drawn for TechConcepts with Anatomy, an open-source isometric kit by wheresryan22, used under the MIT licence.</dd>
          <dt>Type</dt>
          <dd>
            Atkinson Hyperlegible Next and Atkinson Hyperlegible Mono, from the Braille Institute, made to be easy to read. Headings are set in
            Barlow Semi Condensed, by the Barlow Project Authors.
          </dd>
        </dl>
      </section>

      <section class="a-sec" id="privacy" aria-labelledby="privacy-h">
        <h2 id="privacy-h">Your progress stays with you</h2>
        <p>
          TechConcepts remembers a few things so you can pick up where you left off. They are saved only in this browser, on this device, and
          never sent to a server. There are no accounts.
        </p>
        <table class="a-saved">
          <caption>What the site remembers</caption>
          <thead>
            <tr><th scope="col">What</th><th scope="col">Where it’s kept</th></tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Which lessons you started and finished</th>
              <td><span class="where"><span class="dot" aria-hidden="true"></span>This browser only</span></td>
            </tr>
            <tr>
              <th scope="row">Light or dark theme</th>
              <td><span class="where"><span class="dot" aria-hidden="true"></span>This browser only</span></td>
            </tr>
            <tr>
              <th scope="row">Your Practice answers</th>
              <td><span class="where"><span class="dot off" aria-hidden="true"></span>Not saved at all</span></td>
            </tr>
          </tbody>
        </table>
        {analyticsToken?.trim() && <p>The site counts page views with privacy-friendly analytics that use no cookies and know nothing about your progress.</p>}
        <p>To start fresh, reset it here. Clearing your browser data does the same.</p>
        <ResetProgress client:load />
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { followSections } from '../scripts/about-toc';

  // The list marks the section being read. Without JavaScript its links still work, and nothing is marked.
  const nav = document.querySelector<HTMLElement>('.a-toc');
  if (nav) followSections(nav);
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* ---------- The opening: the line, what the site is, and its three counts ---------- */
  .a-open {
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: clamp(28px, 4vw, 48px);
  }
  .a-crumbs ol {
    display: flex;
    gap: 8px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 15px;
  }
  .a-crumbs li + li::before {
    content: '/';
    margin-right: 8px;
  }
  .a-crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .a-crumbs a:hover {
    text-decoration: underline;
  }
  .a-crumbs [aria-current] {
    color: var(--ink-strong);
  }
  .a-open h1 {
    max-width: 13em;
    margin: 0;
    font-size: clamp(44px, 7.4vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.008em;
    text-wrap: balance;
  }
  .a-open__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px clamp(24px, 5vw, 80px);
    align-items: end;
    margin-top: clamp(20px, 3vw, 36px);
    padding-top: 20px;
    border-top: 2px solid var(--ink-strong);
  }
  .a-lede {
    max-width: 34em;
    margin: 0;
    color: var(--ink-strong);
    font-size: 19px;
    line-height: 1.5;
  }
  /* The counts: each a large figure over its words. */
  .stats {
    display: flex;
    gap: clamp(20px, 3vw, 44px);
    margin: 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }
  .stats dd {
    margin: 0;
    color: var(--ink-strong);
    font: 700 clamp(40px, 4.6vw, 64px) / 0.9 var(--display);
  }
  .stats dt {
    color: var(--muted);
    font: 600 15px/1.2 var(--display);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* ---------- The body: a list of the sections beside a reading column ---------- */
  .a-body {
    display: grid;
    grid-template-columns: 200px minmax(0, 46rem);
    gap: clamp(28px, 6vw, 96px);
    align-items: start;
    padding-top: clamp(28px, 4vw, 48px);
  }
  .a-toc {
    position: sticky;
    top: 96px;
  }
  .a-toc ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .a-toc a {
    display: block;
    padding: 8px 10px;
    border-left: 3px solid var(--line);
    color: var(--ink);
    font: 600 16px/1.25 var(--display);
    text-decoration: none;
  }
  .a-toc a:hover {
    color: var(--ink-strong);
  }
  .a-toc a[aria-current] {
    border-left-color: var(--here);
    background: var(--here-soft);
    color: var(--ink-strong);
  }
  .a-sec {
    padding-bottom: clamp(36px, 5vw, 64px);
    /* Clear of the sticky header when a link lands here. */
    scroll-margin-top: 92px;
  }
  .a-sec + .a-sec {
    padding-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--line-strong);
  }
  .a-sec:last-child {
    padding-bottom: 0;
  }
  .a-sec h2 {
    margin: 0 0 14px;
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 1.05;
  }
  .a-sec p {
    margin: 0 0 14px;
    font-size: 18px;
    line-height: 1.55;
  }
  .a-sec p:last-child {
    margin-bottom: 0;
  }
  .a-sec a {
    color: var(--link);
  }

  /* How a lesson works: three parts in order, each with its small figure. */
  .a-steps {
    display: grid;
    gap: 12px;
    margin: 20px 0;
    padding: 0;
    list-style: none;
  }
  .a-steps li {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    align-items: center;
    overflow: hidden;
  }
  .a-steps .art {
    align-self: stretch;
    display: grid;
    place-items: center;
    border-right: 1px solid var(--line-strong);
    background: var(--fig-bg);
  }
  .a-steps .art svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .a-steps .body {
    padding: 18px 22px;
  }
  .a-steps .n {
    color: var(--here);
    font: 600 15px/1.2 var(--display);
    letter-spacing: 0.02em;
  }
  .a-steps h3 {
    margin: 4px 0 6px;
    font-size: 24px;
  }
  .a-steps p {
    font-size: 16.5px;
  }
  .a-note {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    margin: 0 0 14px;
    padding: 14px 16px;
    border-left: 3px solid var(--ink-strong);
    background: var(--card);
  }
  .a-note b {
    color: var(--ink-strong);
  }
  .a-note .t {
    width: 22px;
    height: 22px;
    margin-top: 3px;
    color: var(--ink-strong);
  }
  .a-note p {
    font-size: 17px;
  }

  /* Where the facts come from: the words beside the figure, then one lesson's sources as the example. */
  .a-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 24px;
    align-items: center;
    margin-bottom: 18px;
  }
  .a-facts__art svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .a-src {
    padding: 18px 22px;
  }
  .a-src h3 {
    margin: 0 0 10px;
    color: var(--muted);
    font: 600 15px/1.2 var(--display);
    letter-spacing: 0.02em;
  }
  .a-src ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .a-src li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 14px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 16.5px;
  }
  .a-src li span {
    color: var(--ink-strong);
    font: 500 15px/1.6 var(--mono);
  }

  .a-credits {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 0 14px;
    margin: 18px 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .a-credits dt,
  .a-credits dd {
    margin: 0;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16.5px;
  }
  .a-credits dt {
    color: var(--muted);
    font: 600 15px/1.7 var(--display);
    letter-spacing: 0.02em;
  }

  /* What the site remembers. */
  .a-saved {
    width: 100%;
    margin: 18px 0;
    border-collapse: collapse;
    font-size: 16.5px;
  }
  .a-saved caption {
    padding-bottom: 8px;
    color: var(--muted);
    font: 600 15px/1.2 var(--display);
    letter-spacing: 0.02em;
    text-align: left;
  }
  .a-saved th,
  .a-saved td {
    padding: 12px 12px 12px 0;
    border-top: 1px solid var(--line);
    font-weight: 400;
    text-align: left;
    vertical-align: top;
  }
  .a-saved thead th {
    border-top: 1px solid var(--line-strong);
    color: var(--muted);
    font: 600 14px/1.2 var(--display);
    letter-spacing: 0.02em;
  }
  .a-saved tbody th {
    color: var(--ink-strong);
  }
  .a-saved .where {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .a-saved .dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--ink-strong);
  }
  .a-saved .dot.off {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--muted);
  }
  .a-reset {
    margin-top: 16px;
  }
  .a-reset .q {
    margin: 0 0 10px;
    color: var(--ink-strong);
    font-weight: 600;
  }
  .a-reset [role='group'] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .a-reset [role='status'] {
    margin: 10px 0 0;
    color: var(--allowed-text);
    font-size: 16px;
  }

  @media (max-width: 860px) {
    .a-open__row {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .a-body {
      grid-template-columns: minmax(0, 1fr);
    }
    /* On a phone the list of sections is a row to swipe, under the opening and no longer stuck. */
    .a-toc {
      position: static;
    }
    .a-toc .toc-h {
      display: none;
    }
    .a-toc ol {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 6px;
    }
    .a-toc a {
      border: 1px solid var(--line-strong);
      border-radius: 4px;
      white-space: nowrap;
    }
    .a-toc a[aria-current] {
      border-color: var(--here);
    }
    .a-steps li {
      grid-template-columns: 110px minmax(0, 1fr);
    }
    .a-facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .a-facts__art {
      max-width: 300px;
    }
  }
</style>
