---
// About (docs/direction.md §11). A plain opening with the site's three counts, then what it is, how a lesson works,
// where the facts come from, credits, and where progress is kept. The counts, the tracks still to come and the DHCP
// lesson's sources are worked out from the content. Only Reset progress runs as an island. The "On this page" list
// is plain links in the opening, and no script runs on the page but the header's and that island (D21b, Folders).
import { pageFigure } from '../art/figures/pages';
import { spot } from '../art/figures/spots';
import { getLesson } from '../content/registry';
import type { Lesson } from '../content/schema';
import { comingSoonTracks, plannedTracks, tracks } from '../content/tracks';
import { comingTracksSentence, factCheckSentence, sourceRows } from '../lib/about';
import { lessonCheckCounts } from '../lib/checked';
import { analyticsToken } from '../lib/analytics';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResetProgress from '../components/ResetProgress';
import '../components/site.css';
import '../styles/card-stack.css';

// The first track, How the Internet Works, is the one "Who it's for" names: the beginner entry.
const track = tracks[0]!;

/** A ready lesson, by slug, whichever track lists it. */
function readyLesson(slug: string): Lesson {
  const lesson = getLesson(slug);
  if (lesson === undefined) throw new Error(`About needs the ${slug} lesson, and it is not ready.`);
  return lesson;
}

// ---------- Hero ----------
// The tracks with lessons, the one being written (CompTIA A+), and the ones further out.
const tracksPlanned = tracks.length + plannedTracks.length + comingSoonTracks.length;

// ---------- Body ----------
// The tracks with no lessons yet, the nearest first: CompTIA A+, then the ones further out.
const coming = comingTracksSentence([...plannedTracks, ...comingSoonTracks].map((t) => t.title));
const dhcp = readyLesson('dhcp');
const sources = sourceRows(dhcp.units.flatMap((u) => u.references));
// The first three sources show; the rest are behind a native fold (Home's pattern). Six or fewer need no fold.
const SHOWN = 3;
const folded = sources.length > 6;
const shown = folded ? sources.slice(0, SHOWN) : sources;
const rest = folded ? sources.slice(SHOWN) : [];
// How many ready lessons have passed the fact-checker (src/lib/checked.ts); Home says the same sentence.
const checks = lessonCheckCounts();
// A lesson two tracks list is one lesson, so the ready count is the distinct count, not a sum over tracks.
const lessonsReady = checks.total;
const factCheck = factCheckSentence(checks.checked, checks.total);
---

<BaseLayout
  title="About"
  current="about"
  description="What TechConcepts is, how its lessons are made, who inspired it, and how it keeps your progress private."
>
  <section class="wrap a-open" aria-labelledby="about-title">
    <div class="a-open__main">
      <nav class="a-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><span aria-current="page">About</span></li>
        </ol>
      </nav>
      <h1 id="about-title">Watch it happen, then learn its name.</h1>
      <p class="a-lede">
        TechConcepts is a free site of short, visual lessons on how technology works. You watch a real process play out one step at a time, then
        read what it was, in plain words.
      </p>
    </div>
    <div class="a-open__side">
      <dl class="stats cs-card">
        <div><dt>tracks planned</dt><dd>{tracksPlanned}</dd></div>
        <div><dt>lessons ready</dt><dd>{lessonsReady}</dd></div>
        <div><dt>accounts needed</dt><dd>0</dd></div>
      </dl>
      <nav class="a-toc cs-card" aria-label="On this page">
        <p class="a-toc__h cs-tab">On this page</p>
        <ol>
          <li><a href="#what">What it is</a></li>
          <li><a href="#lessons">How a lesson works</a></li>
          <li><a href="#facts">Where the facts come from</a></li>
          <li><a href="#credits">Credits</a></li>
          <li><a href="#privacy">Your progress</a></li>
        </ol>
      </nav>
    </div>
  </section>

  <div class="wrap a-body">
    <section class="a-sec cs-card" id="what" aria-labelledby="what-h">
      <h2 class="cs-tab" id="what-h">What TechConcepts is</h2>
      <div class="a-cols">
        <p>
          TechConcepts teaches how technology works by showing it. Each lesson plays a real process, such as a laptop asking the network for an
          address, one step at a time, and explains each step in plain words.
        </p>
        <p>
          The first track, {track.title}, is written for anyone starting out, including people studying for entry-level IT certifications. {coming}
        </p>
        <p>You don’t need an account, and you can open any lesson in any order.</p>
      </div>
    </section>

    <section class="a-sec cs-card" id="lessons" aria-labelledby="lessons-h">
      <h2 class="cs-tab" id="lessons-h">How a lesson works</h2>
      <p>Every lesson has the same three parts, so you always know where you are.</p>
      <ol class="a-steps">
        <li>
          <div class="art" set:html={spot('watch')} />
          <div class="body">
            <span class="n"><b>1</b> Watch</span>
            <h3>See it happen</h3>
            <p>A scene plays the process step by step. Pause it, slow it down, or go back a step whenever you like.</p>
          </div>
        </li>
        <li>
          <div class="art" set:html={spot('learn')} />
          <div class="body">
            <span class="n"><b>2</b> Learn</span>
            <h3>Get the idea, then the name</h3>
            <p>Each idea starts with an everyday comparison, then gives you the real term. Exam detail waits under Go deeper, closed until you want it.</p>
          </div>
        </li>
        <li>
          <div class="art" set:html={spot('practice')} />
          <div class="body">
            <span class="n"><b>3</b> Practice</span>
            <h3>Check yourself</h3>
            <p>A few questions, just for you. Each answer says why it’s right or not. Nothing is scored or saved.</p>
          </div>
        </li>
      </ol>
      <div class="a-after">
        <div class="a-note">
          <svg class="t" viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
              d="M12 7v5l3.2 2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          <p>
            <b>Lessons are self-paced.</b> Take as long as you need. This browser remembers where you stopped, so you can pick up where you left off.
          </p>
        </div>
        <p>The example networks use addresses set aside for documentation and private use, so nothing in a lesson points at a real machine.</p>
      </div>
    </section>

    <section class="a-sec cs-card" id="facts" aria-labelledby="facts-h">
      <h2 class="cs-tab" id="facts-h">Where the facts come from</h2>
      <div class="a-facts">
        <div>
          <p>
            Each lesson lists the standards it draws on under Sources at the end of Learn. {factCheck}
          </p>
          <div class="a-facts__art" aria-hidden="true" set:html={pageFigure('sources')} />
        </div>
        <div class="a-src">
          <h3>Sources in the {dhcp.title} lesson</h3>
          <ul>
            {
              shown.map((s) => (
                <li>
                  <span>{s.standard}</span>
                  <a href={s.url}>{s.title}</a>
                </li>
              ))
            }
          </ul>
          {
            folded && (
              <details class="a-src__more">
                <summary>
                  <span class="a-src__closed">Show the other {rest.length}</span>
                  <span class="a-src__open">Hide the other {rest.length}</span>
                </summary>
                <ul aria-label={`Sources ${SHOWN + 1} to ${sources.length}`}>
                  {rest.map((s) => (
                    <li>
                      <span>{s.standard}</span>
                      <a href={s.url}>{s.title}</a>
                    </li>
                  ))}
                </ul>
              </details>
            )
          }
        </div>
      </div>
    </section>

    <section class="a-sec cs-card" id="credits" aria-labelledby="credits-h">
      <h2 class="cs-tab" id="credits-h">Credits</h2>
      <div class="a-two">
        <p>
          Protocol Explorer and TryHackMe inspired TechConcepts: the first for the idea of watching a protocol work, the second for its friendly,
          guided way of teaching. They are inspiration only. TechConcepts is not affiliated with, endorsed by, or built from either of them.
        </p>
        <dl class="a-credits">
          <dt>Figures</dt>
          <dd>Drawn for TechConcepts with Anatomy, an open-source isometric kit by wheresryan22, used under the MIT licence.</dd>
          <dt>Type</dt>
          <dd>
            Atkinson Hyperlegible Next and Atkinson Hyperlegible Mono, from the Braille Institute, made to be easy to read. Headings are set in
            Barlow Semi Condensed, by the Barlow Project Authors.
          </dd>
        </dl>
      </div>
    </section>

    <section class="a-sec cs-card" id="privacy" aria-labelledby="privacy-h">
      <h2 class="cs-tab" id="privacy-h">Your progress stays with you</h2>
      <div class="a-two a-keep">
        <p>
          TechConcepts remembers a few things so you can pick up where you left off. They are saved only in this browser, on this device, and
          never sent to a server. There are no accounts.
        </p>
        <div class="a-savedbox">
          <table class="a-saved">
            <caption>What the site remembers</caption>
            <thead>
              <tr><th scope="col">What</th><th scope="col">Where it’s kept</th></tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Which lessons you started and finished</th>
                <td><span class="where"><span class="dot" aria-hidden="true"></span>This browser only</span></td>
              </tr>
              <tr>
                <th scope="row">Light or dark theme</th>
                <td><span class="where"><span class="dot" aria-hidden="true"></span>This browser only</span></td>
              </tr>
              <tr>
                <th scope="row">Your Practice answers</th>
                <td><span class="where"><span class="dot off" aria-hidden="true"></span>Not saved at all</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        {analyticsToken?.trim() && <p>The site counts page views with privacy-friendly analytics that use no cookies and know nothing about your progress.</p>}
        <p>To start fresh, reset it here. Clearing your browser data does the same.</p>
        <ResetProgress client:load />
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
    /* Keyboard focus and every anchor stop clear of the 68px sticky header (as /tracks), and a focus ring clear of the
       window's foot. */
    scroll-padding-top: 80px;
    scroll-padding-bottom: 12px;
  }
  /* While the header's menu is open (below 960px) the header is 391px tall on this page (five links and Start
     learning): its height plus 12px. */
  @media (max-width: 959px) {
    html:has(#menu-panel:not([hidden])) {
      scroll-padding-top: 403px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* ---------- The opening: the line and what the site is at the left; the counts and the list of sections at the right ---------- */
  .a-open {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 0 clamp(32px, 5vw, 80px);
    align-items: start;
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: clamp(28px, 4vw, 48px);
  }
  .a-crumbs ol {
    display: flex;
    gap: 8px;
    margin: 0 0 6px;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 15px;
  }
  .a-crumbs li {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .a-crumbs li + li::before {
    content: '/';
    margin-right: 8px;
  }
  .a-crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }
  .a-crumbs a:hover {
    text-decoration: underline;
  }
  .a-crumbs [aria-current] {
    color: var(--ink-strong);
  }
  .a-open h1 {
    max-width: 13em;
    margin: 0;
    font-size: clamp(44px, 6.6vw, 96px);
    line-height: 0.92;
    letter-spacing: -0.008em;
    text-wrap: balance;
  }
  .a-lede {
    max-width: 34em;
    margin: clamp(20px, 2.4vw, 32px) 0 0;
    color: var(--ink-strong);
    font-size: 19px;
    line-height: 1.5;
  }

  /* The counts: one card, a cell a count, the figure over its words. The figure is sized from the card's own width
     (cqi) and its words stand one over the other at every width, so three cells fit a 256px card whatever the
     figures are. The card is a size container, so it is given a width (the column's) and never sized by its content. */
  .stats {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    min-width: 0;
    padding: 14px clamp(8px, 4.5cqi, 18px) 12px;
  }
  .stats > div + div {
    border-left: 2px solid var(--cs-edge);
  }
  .stats dd {
    margin: 0;
    color: var(--ink-strong);
    font: 700 clamp(30px, 12cqi, 56px) / 0.9 var(--display);
    overflow-wrap: anywhere;
  }
  .stats dt {
    width: min-content;
    color: var(--muted);
    font: 600 15px/1.2 var(--display);
    letter-spacing: 0.02em;
  }

  /* The list of sections is a card named on its tab, a row a section. */
  .a-toc {
    margin-top: 54px;
  }
  .a-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .a-toc a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 18px;
    color: var(--ink-strong);
    font: 600 17px/1.25 var(--display);
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .a-toc li + li a {
    border-top: 1px solid var(--line);
  }
  .a-toc li:last-child a {
    border-radius: 0 0 8px 8px;
  }
  .a-toc a:hover {
    background: var(--cs-quiet);
  }
  .a-toc a:focus-visible {
    outline-offset: -4px;
  }

  /* ---------- A section: the card, its name on a taller tab. A link lands the tab's top 92px down. ---------- */
  .a-sec {
    margin-top: 72px;
    padding: clamp(20px, 2.6vw, 36px);
    scroll-margin-top: 54px;
  }
  .a-sec > h2.cs-tab {
    height: auto;
    min-height: 44px;
    max-width: calc(100% + 4px);
    padding: 6px 18px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
    white-space: normal;
  }
  .a-sec p {
    max-width: 36em;
    margin: 0 0 14px;
    font-size: 18px;
    line-height: 1.55;
  }
  .a-sec p:last-child {
    margin-bottom: 0;
  }
  /* Links in the page are ink with an underline, as on every Card stack page (global.css); no blue. */
  .a-cols {
    columns: 2;
    column-gap: clamp(32px, 5vw, 72px);
  }
  .a-cols > * {
    break-inside: avoid;
  }

  /* How a lesson works: three parts across, a hairline between them; each part's number is a chip. */
  .a-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 22px 0 26px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--cs-hair);
    border-bottom: 1px solid var(--cs-hair);
  }
  .a-steps li {
    padding: 0 0 20px;
  }
  .a-steps li + li {
    border-left: 1px solid var(--cs-hair);
  }
  .a-steps .art {
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--fig-bg);
  }
  .a-steps .art svg,
  .a-facts__art svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .a-steps .body {
    padding: 4px 22px 0;
  }
  .a-steps .n {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--ink-strong);
    font: 600 16px/1 var(--display);
    letter-spacing: 0.01em;
  }
  .a-steps .n b {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 2px solid var(--cs-edge);
    border-radius: 6px;
    font: 700 15px/1 var(--display);
  }
  .a-steps h3 {
    margin: 0 0 6px;
    font-size: 24px;
  }
  .a-steps p {
    font-size: 16.5px;
  }
  .a-after {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .a-note {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    margin: 0;
    padding: 14px 16px;
    border-radius: var(--cs-r-in);
    background: var(--cs-quiet);
  }
  .a-note b {
    color: var(--ink-strong);
  }
  .a-note .t {
    width: 22px;
    height: 22px;
    margin-top: 3px;
    color: var(--ink-strong);
  }
  .a-note p {
    font-size: 17px;
  }

  /* Where the facts come from: the words and the figure at the left, one lesson's sources at the right. The first
     three sources show; the rest are behind a native <details> (Home's pattern). */
  .a-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .a-facts__art {
    max-width: 300px;
    margin-top: 8px;
  }
  .a-src h3 {
    margin: 0 0 4px;
    color: var(--muted);
    font: 600 15px/1.2 var(--display);
    letter-spacing: 0.02em;
  }
  .a-src ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .a-src li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 14px;
    align-items: baseline;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 16.5px;
  }
  .a-src > ul > li:first-child {
    border-top: 0;
  }
  .a-src li span {
    color: var(--ink-strong);
    font: 500 15px/1.6 var(--mono);
  }
  .a-src li a {
    justify-self: start;
    overflow-wrap: anywhere;
  }
  .a-src__more > summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    border-top: 1px solid var(--cs-hair);
    color: var(--ink-strong);
    font: 600 16px/1.2 var(--display);
    letter-spacing: 0.01em;
    list-style: none;
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
  }
  .a-src__more > summary::-webkit-details-marker {
    display: none;
  }
  /* Home's marker: a small square with a plus, a minus once open. */
  .a-src__more > summary::before {
    content: '';
    flex: none;
    width: 16px;
    height: 16px;
    border: 2px solid var(--cs-edge);
    border-radius: 4px;
    background:
      linear-gradient(var(--ink-strong), var(--ink-strong)) center / 7px 1.5px no-repeat,
      linear-gradient(var(--ink-strong), var(--ink-strong)) center / 1.5px 7px no-repeat;
  }
  .a-src__more[open] > summary::before {
    background: linear-gradient(var(--ink-strong), var(--ink-strong)) center / 7px 1.5px no-repeat;
  }
  .a-src__more > summary:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .a-src__more > summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .a-src__open,
  .a-src__more[open] .a-src__closed {
    display: none;
  }
  .a-src__more[open] .a-src__open {
    display: inline;
  }

  .a-two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .a-credits {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 0 14px;
    margin: 0;
  }
  .a-credits dt,
  .a-credits dd {
    margin: 0;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 16.5px;
  }
  .a-credits dt {
    color: var(--muted);
    font: 600 15px/1.7 var(--display);
    letter-spacing: 0.02em;
  }
  .a-credits dt:first-of-type,
  .a-credits dt:first-of-type + dd {
    border-top: 0;
    padding-top: 0;
  }

  /* Your progress: the words and Reset at the left, the table at the right. The markup keeps its order (the words,
     the table, the sentences, Reset); the table is placed in the second column across the rows. */
  .a-keep > * {
    grid-column: 1;
  }
  .a-keep > .a-savedbox {
    grid-column: 2;
    grid-row: 1 / span 4;
  }
  .a-keep p {
    margin: 0;
  }
  .a-saved {
    width: 100%;
    border-collapse: collapse;
    font-size: 16.5px;
  }
  .a-saved caption {
    padding-bottom: 10px;
    color: var(--muted);
    font: 600 15px/1.2 var(--display);
    letter-spacing: 0.02em;
    text-align: left;
  }
  .a-saved th,
  .a-saved td {
    padding: 12px 12px 12px 0;
    border-top: 1px solid var(--line);
    font-weight: 400;
    text-align: left;
    vertical-align: top;
  }
  .a-saved thead th {
    border-top-color: var(--cs-hair);
    color: var(--muted);
    font: 600 14px/1.2 var(--display);
    letter-spacing: 0.02em;
  }
  .a-saved tbody th {
    color: var(--ink-strong);
  }
  .a-saved .where {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .a-saved .dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--ink-strong);
  }
  .a-saved .dot.off {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--muted);
  }
  /* Reset progress: card-stack.css draws the buttons (48px, the offset edge); the row leaves room for that edge. */
  .a-keep .a-reset {
    grid-column: 1;
  }
  .a-reset {
    padding: 0 3px 3px 0;
  }
  .a-reset .q {
    flex-basis: 100%;
    margin: 0 0 10px;
    color: var(--ink-strong);
    font-weight: 600;
  }
  .a-reset [role='group'] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
