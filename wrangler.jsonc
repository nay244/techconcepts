{
  // The Worker's name; Cloudflare shows it in the dashboard and uses it in the preview address.
  // It must match the name of the Cloudflare project the owner creates.
  "name": "techconcepts",
  // Cloudflare's docs ask for a compatibility date (the Workers runtime behaviour to pin).
  // There is no Worker code here, only static files, so the date has no effect on the site.
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    // An unknown address gets the site's own 404 page, with a 404 status.
    "not_found_handling": "404-page",
    // The site links to slash-less addresses such as /networking/dhcp. Serve those
    // directly; /networking/dhcp/ and /networking/dhcp/index.html redirect (307) to them.
    // The default, auto-trailing-slash, would redirect every internal link the other way.
    "html_handling": "drop-trailing-slash"
  },
  // Cloudflare builds every branch other than main with `npx wrangler preview`, which refuses to run without a
  // `previews` block. It stays empty: the assets and settings above apply to previews too.
  "previews": {}
}
