# Cloudflare reads this file at deploy time; it is not served as a page.
# Files under /_astro/ carry a content hash in their names, so a changed file
# gets a new name. Browsers can keep them for a year without checking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Until techconcepts.app is connected, the site is only reachable at Cloudflare's own workers.dev addresses: the
# preview, and one address per branch build. Search engines are told to leave those out of their results. The rule
# names the host, so it stops applying by itself on the real domain.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
